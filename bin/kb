#!/usr/bin/env bash
# Code Knowledge Base builder.
# Reads kb.projects.toml, builds per-project graphify graphs into repos/<name>/,
# merges them into one cross-repo graph, injects HTTP edges (frontend -> controllers),
# clusters + renders the full graph.html, and (re)indexes docs into qmd.
#
# Usage: bin/kb build | update | graph | kb | label | status | qmd-backend | --version
set -euo pipefail

KB="$(cd "$(dirname "$0")/.." && pwd)"
PY=python3
# One source of truth for paths (see bin/paths.py): in a checkout these all resolve to the checkout,
# installed they split into a read-only package dir and writable data/config dirs.
eval "$("$PY" "$KB/bin/paths.py" --sh)"
mkdir -p "$KB_DATA" "$KB_CONFIG"
cd "$KB_DATA"
CFG="$KB_CONFIG/kb.projects.toml"
# Repo version: single source of truth is the VERSION file (see CHANGELOG.md).
KB_VERSION="$(cat "$KB_PACKAGE/VERSION" 2>/dev/null || echo '0+unknown')"
OUT="$KB_OUT"
DOCS_STAGE="$KB_DATA/.docs"      # aggregated docs root for qmd (one collection = one path); gitignored
COLLECTION="${KB_COLLECTION:-kb}"
CONTRACT_DIR="contracts"          # <project docs>/contracts/*.md = contract docs (bin/contracts.py)
SELF_DOCS="${KB_SELF_DOCS_NAME:-kb}"  # project name for the KB checkout's own docs/, if present
LOCAL_CFG="$KB_DATA/.kb.local"   # persisted local choices (e.g. QMD_BACKEND); gitignored
[ -f "$LOCAL_CFG" ] && . "$LOCAL_CFG"
export GRAPHIFY_VIZ_NODE_LIMIT="${GRAPHIFY_VIZ_NODE_LIMIT:-20000}"

require_cfg() {
  [ -f "$CFG" ] && return
  echo "error: $CFG not found." >&2
  echo "Run 'kb-install' (or copy $KB_PACKAGE/kb.projects.toml.example to $CFG)" >&2
  echo "then edit it with your projects' paths." >&2
  exit 1
}

# --- tiny TOML reader: emits "name|code(csv)|docs|routes|calls(csv)|serves" per project
read_projects() { "$PY" - "$CFG" <<'PY'
import re, sys
txt = open(sys.argv[1]).read()
blocks = re.split(r'(?m)^\[\[project\]\]\s*$', txt)[1:]
def val(b, k):
    m = re.search(rf'(?m)^\s*{k}\s*=\s*(.+)$', b)
    if not m: return ""
    raw = m.group(1).split('#',1)[0].strip()
    if raw.startswith('['):
        return ",".join(re.findall(r'"([^"]+)"', raw))
    return raw.strip('"')
for b in blocks:
    print("|".join(val(b,k) for k in ("name","code","docs","routes","calls","serves")))
PY
}

stage_and_build() {
  local name="$1" code_csv="$2"
  local dest="$KB/repos/$name"
  # Keep repos/<name>/graphify-out/ between runs: its cache makes `graphify update` re-extract only
  # changed files. Everything else (the staged sources) is re-copied; rsync -a keeps source mtimes.
  mkdir -p "$dest"
  find "$dest" -mindepth 1 -maxdepth 1 ! -name graphify-out -exec rm -rf {} +
  IFS=',' read -ra dirs <<< "$code_csv"
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && rsync -a --exclude vendor --exclude node_modules --exclude storage \
      --exclude dist --exclude build \
      --exclude tests --exclude '*.png' --exclude '*.svg' --exclude '*.jpg' --exclude '*.jpeg' \
      --exclude '*.gif' --exclude '*.ico' --exclude '*.webp' "$d" "$dest/" 2>/dev/null || true
  done
  echo "  [$name] staged $(find "$dest" -type f \( -name '*.php' -o -name '*.js' -o -name '*.vue' -o -name '*.ts' -o -name '*.tsx' -o -name '*.py' -o -name '*.kt' \) | wc -l) source files"
  graphify update "$dest" >/dev/null 2>&1 || true
}

build_graph() {
  require_cfg
  echo "==> Building per-project graphs"
  local merge_inputs=() routes_specs=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -z "$name" ] && continue
    if [ -z "$code" ]; then
      echo "  [$name] docs-only — skipped from graph"
      continue
    fi
    stage_and_build "$name" "$code"
    merge_inputs+=("$KB/repos/$name/graphify-out/graph.json")
    if [ -n "$routes" ]; then
      # Route table feeds the frontend->controller edges. A silent failure here means the graph
      # quietly loses its cross-repo half, so say so instead of swallowing it.
      # LOG_CHANNEL=null: the indexed app must not get log files from this run (they would be owned
      # by the KB's user, and the app's own user could not append to them later).
      if ! env -C "$routes" LOG_CHANNEL=null php artisan route:list --json >"$KB/routes.$name.json" 2>/dev/null; then
        echo "  [$name] WARNING: 'php artisan route:list' failed — HTTP edges for this repo will be missing" >&2
        rm -f "$KB/routes.$name.json"
      fi
    fi
    [ -n "$calls" ] && [ -n "$serves" ] && routes_specs+=("$serves|$calls")
  done < <(read_projects)

  echo "==> Merging into one cross-repo graph"
  mkdir -p "$OUT"
  if [ "${#merge_inputs[@]}" -ge 2 ]; then
    graphify merge-graphs "${merge_inputs[@]}" --out "$OUT/graph.json" >/dev/null
  else
    # a single-project KB is legitimate — merge-graphs needs >=2, so just adopt the one graph
    cp "${merge_inputs[0]}" "$OUT/graph.json"
  fi

  echo "==> Injecting HTTP edges (frontend -> controllers)"
  # re-walk config for calls/serves with their frontend roots
  while IFS='|' read -r name code docs routes calls serves; do
    [ -z "$calls" ] || [ -z "$serves" ] && continue
    IFS=',' read -ra fe <<< "$calls"
    "$PY" "$KB/bin/link_http.py" "$OUT/graph.json" "$KB/routes.$serves.json" "$serves" "${fe[@]}"
  done < <(read_projects)

  echo "==> Canonicalizing duplicate symbol/reference nodes"
  "$PY" "$KB/bin/dedupe.py" "$OUT/graph.json"
  echo "==> Decluttering framework god nodes (before clustering)"
  "$PY" "$KB/bin/declutter.py" "$OUT/graph.json" "$KB/kb.hubs.txt"
  echo "==> Clustering (locks final community ids)"
  graphify cluster-only "$KB" --no-label >/dev/null
  echo "==> Labeling communities by namespace/domain"
  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json" | head -1
  echo "==> Re-rendering report + full visualization with labels"
  # Clustering and labeling are mutually dependent THROUGH FILES: `cluster-only` can renumber
  # community ids, while the labels file is keyed by those ids. So this is a two-step fixpoint, not a
  # redundant call: label (ids from pass 1) -> re-render with labels (ids may shift) -> label again.
  # Keep both passes; if a third were ever needed the dependency should be expressed instead.
  graphify cluster-only "$KB" --no-label >/dev/null
  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json" >/dev/null

  echo "==> Enriching with node types, domains, db_table nodes + domain anchors"
  "$PY" "$KB/bin/enrich.py" "$OUT/graph.json" "$KB/repos"
  echo "==> Adding data-layer links (eloquent model rels, FK table->table, SQL code->table)"
  "$PY" "$KB/bin/link_data.py" "$OUT/graph.json" "$KB/repos"
  # Docs as graph nodes (bin/lang/markdown.py): [[wikilink]] and relative links are EXTRACTED edges,
  # a bare symbol mention is INFERRED and capped. Runs after the code plugins — it points at their nodes.
  local doc_roots=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$docs" ] && [ -d "$docs" ] && doc_roots+=("$name=$docs")
  done < <(read_projects)
  if [ "${#doc_roots[@]}" -gt 0 ]; then
    echo "==> Linking docs into the graph (${#doc_roots[@]} doc roots)"
    "$PY" "$KB/bin/link_docs.py" "$OUT/graph.json" "${doc_roots[@]}"
  fi
  echo "==> Mining rationale comments (NOTE/WHY/HACK/SECURITY -> rationale nodes)"
  "$PY" "$KB/bin/link_rationale.py" "$OUT/graph.json" "$KB/repos"
  echo "==> Rendering custom typed/domain visualization"
  "$PY" "$KB/bin/render_viz.py" "$OUT/graph.json" "$OUT"
  rm -f "$OUT/kb-graph.html"   # 0.5.0: the shell moved to web/; drop the stale generated page
  echo "    graphify graph.html (raw upstream view) -> $OUT · shell: web/index.html"
  build_contracts
}

# The contract layer (bin/contracts.py): routes joined with their frontend call sites, the service
# map from <docs>/contracts/*.md, and the gaps between the two. Read by contracts_search,
# connections and problems; built after the graph because it reads its http_request edges.
build_contracts() {
  local specs=() docs_specs=() prob_specs=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$routes" ] && [ -f "$KB/routes.$name.json" ] && specs+=("$name=$KB/routes.$name.json")
    [ -n "$docs" ] && [ -d "$docs" ] && docs_specs+=("$name=$docs") && prob_specs+=("docs:$name=$docs")
    [ -n "$routes" ] && prob_specs+=("routes:$name=$KB/routes.$name.json")
    [ -n "$calls" ] && [ -n "$serves" ] && prob_specs+=("calls:$name=$serves=$calls")
  done < <(read_projects)
  # The KB service's own contract docs, if this checkout has any (<data>/docs/contracts/).
  [ -d "$KB_DATA/docs/$CONTRACT_DIR" ] && docs_specs+=("$SELF_DOCS=$KB_DATA/docs")
  echo "==> Building the contract index (routes + frontend call sites)"
  "$PY" "$KB/bin/contracts.py" contracts "$OUT/graph.json" "$OUT/contracts.json" "${specs[@]}"
  echo "==> Building the connection map (contract docs + HTTP calls)"
  "$PY" "$KB/bin/contracts.py" connections "$OUT/contracts.json" "$OUT/connections.json" "${docs_specs[@]}"
  echo "==> Finding problems (contract docs, unknown routes)"
  "$PY" "$KB/bin/contracts.py" problems "$OUT/connections.json" "$OUT/problems.json" "${prob_specs[@]}"
}

# Where qmd gets its vector embeddings. Resolved once and remembered in .kb.local.
#   none  - skip vectors; BM25 keyword search only (no model download)
#   llama - on-device llama.cpp embeddings (qmd default; downloads a small GGUF model)
#   other - bring your own: runs $KB_QMD_EMBED_CMD if set, else plain `qmd embed`
#           (point qmd at your own model/endpoint via its env)
# Precedence: KB_QMD_BACKEND env > persisted QMD_BACKEND > interactive prompt > llama.
resolve_qmd_backend() {
  local b="${KB_QMD_BACKEND:-${QMD_BACKEND:-}}"
  if [ -z "$b" ]; then
    if [ -t 0 ]; then
      {
        echo "Where should qmd plug its embeddings?"
        echo "  none  - skip vectors; BM25 keyword search only (no model download)"
        echo "  llama - on-device llama.cpp embeddings (qmd default; downloads a small model)"
        echo "  other - configure qmd yourself, or set KB_QMD_EMBED_CMD"
      } >&2
      local ans; read -rp "  [none|llama|other] (llama): " ans </dev/tty || ans=""
      b="${ans:-llama}"
    else
      b="llama"   # non-interactive (CI, hooks): default to the on-device backend
    fi
  fi
  case "$b" in none|llama|other) ;; *) b="llama" ;; esac
  # persist the resolved choice (env override is not persisted — it's a one-off)
  if [ -z "${KB_QMD_BACKEND:-}" ] && [ "${QMD_BACKEND:-}" != "$b" ]; then
    printf 'QMD_BACKEND=%s\n' "$b" > "$LOCAL_CFG"
  fi
  QMD_BACKEND="$b"
  echo "$b"
}

qmd_embed() {
  local b; b="$(resolve_qmd_backend)"
  case "$b" in
    none)  echo "    qmd backend=none — skipping embeddings (BM25 keyword search only)" ;;
    other) if [ -n "${KB_QMD_EMBED_CMD:-}" ]; then
             echo "    qmd backend=other — running KB_QMD_EMBED_CMD"; eval "$KB_QMD_EMBED_CMD" || true
           else
             echo "    qmd backend=other — running 'qmd embed' (configure qmd's model/endpoint via its env)"
             qmd embed 2>/dev/null || true
           fi ;;
    llama) qmd embed 2>/dev/null || true ;;
  esac
}

build_kb() {
  require_cfg
  echo "==> Staging + indexing docs into qmd collection '$COLLECTION'"
  [ -d "$KB/.qmd" ] || qmd init >/dev/null 2>&1 || true
  # Every project's docs are staged under $DOCS_STAGE/<project>/ (one qmd collection each, below).
  # rsync --delete in place, never rm -rf first: a search during a rebuild still finds the docs.
  mkdir -p "$DOCS_STAGE"
  local staged=0 keep=()
  local roots=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$docs" ] && [ -d "$docs" ] && roots+=("$name|$docs")
  done < <(read_projects)
  [ -d "$KB_DATA/docs" ] && roots+=("$SELF_DOCS|$KB_DATA/docs")
  local root name docs
  for root in "${roots[@]}"; do
    name="${root%%|*}"; docs="${root#*|}"
    keep+=("$name")
    mkdir -p "$DOCS_STAGE/$name"
    rsync -a --delete --prune-empty-dirs \
      --exclude='node_modules/' --exclude='.git/' --exclude='vendor/' \
      --include='*/' --include='*.md' --exclude='*' \
      "$docs/" "$DOCS_STAGE/$name/" 2>/dev/null || true
    # Non-markdown documents (PDF, docx, scans) are extracted into the same staged tree, so the doc
    # index sees them too. One parser per format lives in bin/parsers/; a format whose external tool
    # is absent is reported and skipped, never fatal. Extracted files carry a provenance header, so an
    # OCR'd scan is never mistaken for authored text. Opt out with KB_EXTRACT=0.
    if [ "${KB_EXTRACT:-1}" != "0" ]; then
      find "$docs" -type f \( -iname '*.pdf' -o -iname '*.docx' -o -iname '*.odt' -o -iname '*.rtf' \
        -o -iname '*.epub' -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.tif' -o -iname '*.tiff' \) \
        -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/vendor/*' -print0 2>/dev/null \
        | xargs -0 -r "$PY" "$KB/bin/extract" --into "$DOCS_STAGE/$name" 2>&1 | sed 's/^/    /'
    fi
    echo "  [$name] staged $(find "$DOCS_STAGE/$name" -name '*.md' | wc -l) docs"
    staged=1
  done
  # drop the staged docs of a project that left kb.projects.toml
  local d
  for d in "$DOCS_STAGE"/*/; do
    [ -d "$d" ] || continue
    [[ " ${keep[*]} " == *" $(basename "$d") "* ]] || rm -rf "$d"
  done
  [ "$staged" = 1 ] || { echo "  (no docs configured)"; return; }
  # One qmd collection per project ($COLLECTION-<project>), so a search can be scoped to one project
  # and the rest of the network stays out of its results. Searching all projects = all collections.
  # The pre-0.11 single aggregated collection "$COLLECTION" and collections of projects dropped from
  # the config are removed here.
  local want=() n
  for n in "$DOCS_STAGE"/*/; do want+=("$COLLECTION-$(basename "$n")"); done
  qmd collection remove "$COLLECTION" >/dev/null 2>&1 || true
  while read -r n; do
    [[ " ${want[*]} " == *" $n "* ]] || qmd collection remove "$n" >/dev/null 2>&1 || true
  done < <(qmd collection list 2>/dev/null | awk -v p="$COLLECTION-" 'index($1,p)==1{print $1}')
  for n in "$DOCS_STAGE"/*/; do
    n="$(basename "$n")"
    local cur; cur="$(qmd collection show "$COLLECTION-$n" 2>/dev/null | awk -F': *' '/Path:/{print $2; exit}' || true)"
    if [ "$cur" != "$DOCS_STAGE/$n" ]; then
      qmd collection remove "$COLLECTION-$n" >/dev/null 2>&1 || true
      qmd collection add "$DOCS_STAGE/$n" --name "$COLLECTION-$n" >/dev/null 2>&1 || true
    fi
  done
  qmd update 2>/dev/null || true
  qmd_embed
  qmd status || true
}

case "${1:-build}" in
  --version|-V|version)
          echo "knowledge-index $KB_VERSION"
          echo "  graphify: $(graphify --version 2>/dev/null || echo 'not found')"
          echo "  qmd:      $(qmd --version 2>/dev/null || echo 'not found')"
          "$PY" "$KB/bin/paths.py" | sed 's/^/  /'
          ;;
  build)  build_graph; build_kb ;;
  graph)  build_graph ;;
  kb)     build_kb ;;
  update) build_graph; build_kb >/dev/null; echo "refreshed" ;;
  qmd-backend) rm -f "$LOCAL_CFG"; unset QMD_BACKEND; echo "qmd backend set to: $(resolve_qmd_backend)" ;;
  label)  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json"
          graphify cluster-only "$KB" --no-label >/dev/null; echo "relabeled + report regenerated" ;;
  vendor) "$PY" -c "import sys; sys.path.insert(0,'$KB/bin'); import paths; print(paths.stage_web())" >/dev/null
          W="$KB_WEB"; mkdir -p "$W/vendor"
          curl -fsSL https://unpkg.com/vis-network/standalone/umd/vis-network.min.js \
            -o "$W/vendor/vis-network.min.js" &&
            echo "vendored $W/vendor/vis-network.min.js — the dashboard now works offline" ;;
  open)   W="$KB_WEB"; [ -f "$W/index.html" ] || "$PY" -c "import sys;sys.path.insert(0,'$KB/bin');import paths;paths.stage_web()"
          xdg-open "$W/index.html" 2>/dev/null || echo "open $W/index.html" ;;
  status) graphify diagnose multigraph --graph "$OUT/graph.json" | head -8; echo; qmd status ;;
  *) echo "usage: kb {build|graph|kb|update|label|status|open|vendor|qmd-backend|--version}"; exit 1 ;;
esac
