#!/usr/bin/env bash
# Code Knowledge Base builder.
# Reads kb.projects.toml, builds per-project graphify graphs into repos/<name>/,
# merges them into one cross-repo graph, injects HTTP edges (frontend -> controllers),
# clusters + renders the full graph.html, and (re)indexes docs into qmd.
#
# Usage: bin/kb build | update | graph | kb | label | status | qmd-backend | --version
set -euo pipefail

KB="$(cd "$(dirname "$0")/.." && pwd)"
PY=python3
# One source of truth for paths (see bin/paths.py): in a checkout these all resolve to the checkout,
# installed they split into a read-only package dir and writable data/config dirs.
eval "$("$PY" "$KB/bin/paths.py" --sh)"
mkdir -p "$KB_DATA" "$KB_CONFIG"
cd "$KB_DATA"
CFG="$KB_CONFIG/kb.projects.toml"
# Repo version: single source of truth is the VERSION file (see CHANGELOG.md).
KB_VERSION="$(cat "$KB_PACKAGE/VERSION" 2>/dev/null || echo '0+unknown')"
OUT="$KB_OUT"
DOCS_STAGE="$KB_DATA/.docs"      # aggregated docs root for qmd (one collection = one path); gitignored
COLLECTION="${KB_COLLECTION:-kb}"
CONTRACT_DIR="contracts"          # <project docs>/contracts/*.md = contract docs (bin/contracts.py)
SELF_DOCS="${KB_SELF_DOCS_NAME:-kb}"  # project name for the KB checkout's own docs/, if present
LOCAL_CFG="$KB_DATA/.kb.local"   # persisted local choices (e.g. QMD_BACKEND); gitignored
[ -f "$LOCAL_CFG" ] && . "$LOCAL_CFG"
export GRAPHIFY_VIZ_NODE_LIMIT="${GRAPHIFY_VIZ_NODE_LIMIT:-20000}"

# Set while build_graph rewrites graph.json; on a failed exit the previous graph comes back.
GRAPH_PREV=""
# Projects whose code could not be staged or built this run. The build goes on with their previous
# graph and exits non-zero at the end ("Failures are loud", docs/design.md).
BUILD_ERRORS=""
BUILD_START=""
BUILD_KIND=""
# Seconds per build step: `step "title"` closes the open step, prints its time and opens the next one.
STEP_NAME=""
STEP_START=0
STEP_TIMES=""
step_end() {
  [ -n "$STEP_NAME" ] || return 0
  local took=$(( $(date +%s) - STEP_START ))
  echo "    (${took}s)"
  STEP_TIMES+=" | ${took}s ${STEP_NAME}"
  STEP_NAME=""
}
step() {
  step_end
  STEP_NAME="$1"
  STEP_START=$(date +%s)
  echo "==> $1"
}
keep_graph() {
  local rc=$?
  step_end || true
  if [ -n "$BUILD_START" ]; then  # one line per build: when, exit, seconds, which build (admin charts)
    mkdir -p "$KB_DATA/logs"
    echo "$(date '+%F %T') exit=$rc $(( $(date +%s) - BUILD_START ))s $BUILD_KIND" >>"$KB_DATA/logs/builds.log"
    # the same build split by step, to see where the time goes
    [ -z "$STEP_TIMES" ] || echo "$(date '+%F %T') exit=$rc $BUILD_KIND$STEP_TIMES" >>"$KB_DATA/logs/build-steps.log"
  fi
  if [ "$rc" -ne 0 ] && [ -n "$GRAPH_PREV" ] && [ -f "$GRAPH_PREV" ]; then
    mv -f "$GRAPH_PREV" "$OUT/graph.json"
    touch "$OUT/graph.json"   # newer than any per-caller copy cut from the half-built graph
    echo "error: the graph build failed — kept the previous graph" >&2
  fi
  return "$rc"
}
trap keep_graph EXIT

# The parsed project file (parse_projects), read once by require_cfg.
PROJECTS=""
require_cfg() {
  if [ ! -f "$CFG" ]; then
    echo "error: $CFG not found." >&2
    echo "Run 'kb-install' (or copy $KB_PACKAGE/kb.projects.toml.example to $CFG)" >&2
    echo "then edit it with your projects' paths." >&2
    exit 1
  fi
  PROJECTS="$(parse_projects)" || exit 1   # a broken file stops the build here, with the reason
}

# --- kb.projects.toml, read with tomllib: one line "name|code(csv)|docs|routes|calls(csv)|serves(csv)"
# per project. A list key also takes one string. `|`, `,` and newlines in a value are refused: they
# would split the line.
parse_projects() { "$PY" - "$CFG" <<'PY'
import sys, tomllib
cfg = sys.argv[1]
try:
    with open(cfg, "rb") as fh:
        projects = tomllib.load(fh).get("project", [])
except (OSError, tomllib.TOMLDecodeError) as e:
    sys.exit(f"error: {cfg}: {e}")
LISTS = ("code", "calls", "serves")
KEYS = ("name", "code", "docs", "routes", "calls", "serves")
# Node repo tags the build gives its own nodes (db::<table>, domain::<name>): a project of that name
# would mix its nodes with them.
RESERVED = ("db", "domain")
def val(p, k):
    v = p.get(k, "")
    vals = [v] if isinstance(v, str) else v
    if not isinstance(vals, list) or not all(isinstance(x, str) for x in vals) \
            or (k not in LISTS and not isinstance(v, str)):
        sys.exit(f"error: {cfg}: project {p.get('name')!r}: `{k}` must be "
                 + ("a string or a list of strings" if k in LISTS else "a string"))
    for x in vals:
        if any(c in x for c in "|,\n"):
            sys.exit(f"error: {cfg}: project {p.get('name')!r}: `{k}` value {x!r} has '|', ',' or a newline")
    return ",".join(x for x in vals if x)
if not isinstance(projects, list) or not all(isinstance(p, dict) for p in projects):
    sys.exit(f"error: {cfg}: use [[project]] blocks")
seen = set()
for i, p in enumerate(projects, 1):
    name = p.get("name")
    if not isinstance(name, str) or not name.strip():
        sys.exit(f"error: {cfg}: [[project]] block {i} has no `name`")
    if name in RESERVED:
        sys.exit(f"error: {cfg}: project name {name!r} is reserved (the build uses it for its own nodes)")
    if name in seen:
        # both would stage into repos/<name>/ and every repo tag of the merged graph would be wrong
        sys.exit(f"error: {cfg}: project {name!r} is named twice")
    seen.add(name)
    for k in sorted(set(p) - set(KEYS)):
        print(f"warning: {cfg}: project {name!r}: unknown key `{k}` (known: {', '.join(KEYS)})",
              file=sys.stderr)
for p in projects:
    print("|".join(val(p, k) for k in KEYS))
PY
}
read_projects() { [ -z "$PROJECTS" ] || printf '%s\n' "$PROJECTS"; }

# The migration folders of the Laravel projects (`routes` = an app folder). bin/link_data.py reads
# them for the FK edges, and the build signature hashes them. Keep in step with
# lang/php_laravel.py (MIGRATIONS_SUBDIR).
migration_dirs() {
  local name code docs routes calls serves
  while IFS='|' read -r name code docs routes calls serves; do
    if [ -n "$routes" ] && [ -d "$routes/database/migrations" ]; then echo "$routes/database/migrations"; fi
  done < <(read_projects)
}

# Stage one project's code folders into repos/<name>/ and build its graph there. A missing folder, a
# failed copy, two folders with one name or a stage without files is an error: the project keeps its
# previous graph, its name goes into BUILD_ERRORS, and the build exits non-zero at the end.
stage_and_build() {
  local name="$1" code_csv="$2"
  local dest="$KB_DATA/repos/$name"
  local out="$dest/graphify-out"
  local d base rc err files dirs=()
  local -A seen=()
  IFS=',' read -ra dirs <<< "$code_csv"
  # Check every folder before the old copy is removed: a broken config must not wipe the last good one.
  for d in "${dirs[@]}"; do
    d="${d%/}"
    if [ ! -d "$d" ]; then
      echo "  [$name] error: code folder $d is missing — kept the previous graph of this project" >&2
      BUILD_ERRORS+=" $name"; return 0
    fi
    # Each folder lands in repos/<name>/<folder name>/: two folders with one name overwrite each other.
    base="$(basename "$d")"
    if [ -n "${seen[$base]:-}" ]; then
      echo "  [$name] error: code folders ${seen[$base]} and $d have the same folder name '$base' and would" \
           "overwrite each other in repos/$name/$base — kept the previous graph of this project" >&2
      BUILD_ERRORS+=" $name"; return 0
    fi
    seen[$base]="$d"
  done
  # Keep repos/<name>/graphify-out/ between runs: its cache makes `graphify update` re-extract only
  # changed files. Everything else (the staged sources) is re-copied; rsync -a keeps source mtimes.
  mkdir -p "$dest"
  find "$dest" -mindepth 1 -maxdepth 1 ! -name graphify-out -exec rm -rf {} +
  for d in "${dirs[@]}"; do
    # Build output and caches are not source: `.next` of a Next.js app alone was 2.1 GB per build.
    # Secrets never reach the KB: bootstrap/cache/config.php holds the DB password and APP_KEY after
    # `config:cache`, and .env files hold the rest (.env.example stays: it names the keys, no values).
    # These excludes are the only filter: the same graph in a checkout, a pip install and Docker.
    rc=0
    err=$(rsync -a --include .env.example --exclude '.env' --exclude '.env.*' \
      --exclude bootstrap/cache --exclude .git \
      --exclude vendor --exclude node_modules --exclude storage --exclude public \
      --exclude dist --exclude build --exclude .next --exclude .nuxt --exclude .output \
      --exclude coverage --exclude .turbo --exclude .cache --exclude tests \
      --exclude '*.png' --exclude '*.svg' --exclude '*.jpg' --exclude '*.jpeg' --exclude '*.gif' \
      --exclude '*.ico' --exclude '*.webp' --exclude '*.bmp' --exclude '*.pdf' --exclude '*.woff' \
      --exclude '*.woff2' --exclude '*.ttf' --exclude '*.eot' --exclude '*.map' --exclude '*.min.js' \
      --exclude '*.min.css' --exclude '*.lock' --exclude '*.json' \
      "${d%/}" "$dest/" 2>&1) || rc=$?
    # Exit 24: files vanished during the copy (a checkout in the middle of a pull). The copy is usable.
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 24 ]; then
      echo "  [$name] error: copying $d failed (rsync exit $rc): $(tail -1 <<<"$err") — kept the previous graph" >&2
      rm -f "$out/.kb-manifest"   # the half-staged copy must not count as built
      BUILD_ERRORS+=" $name"; return 0
    fi
  done
  files=$(find "$dest" -path "$out" -prune -o -type f -print | wc -l)
  if [ "$files" -eq 0 ]; then
    echo "  [$name] error: no files staged from $code_csv — kept the previous graph of this project" >&2
    rm -f "$out/.kb-manifest"
    BUILD_ERRORS+=" $name"; return 0
  fi
  echo "  [$name] staged $(find "$dest" -type f \( -name '*.php' -o -name '*.js' -o -name '*.vue' -o -name '*.ts' -o -name '*.tsx' -o -name '*.py' -o -name '*.kt' \) | wc -l) source files"
  # Skip graphify when no staged file changed since the last build (path, size, mtime + the graphify
  # version): an unchanged project cost 3-15 s for nothing. `kb build` and KB_FORCE=1 always rebuild.
  local manifest sig
  manifest=$( { graphify --version 2>&1 | head -1
                find "$dest" -path "$out" -prune -o -type f -printf '%P %s %T@\n' | LC_ALL=C sort; } | sha256sum)
  sig="$out/.kb-manifest"
  if [ "${BUILD_KIND:-}" != "build" ] && [ "${KB_FORCE:-0}" != "1" ] && [ -f "$out/graph.json" ] \
      && [ -f "$sig" ] && [ "$(cat "$sig")" = "$manifest" ]; then
    echo "  [$name] unchanged — graph kept"
    return 0
  fi
  # No signature while graphify runs: a run that dies here must not leave one that matches.
  rm -f "$sig"
  # Incremental first: graphify's cache re-extracts only changed files (about half the time of a full
  # pass). graphify refuses to write a graph with fewer nodes than before (its guard against partial
  # rebuilds), and deleted code is exactly that case: then it says "Refusing to overwrite" and we run
  # the full pass with --force, because the staged copy is the truth.
  # Success is exit 0 and a graph.json. Do not ask for a newer graph.json: graphify leaves it
  # untouched when a code change does not change the graph.
  local log
  rc=0
  if [ "${BUILD_KIND:-}" = "build" ] || [ "${KB_FORCE:-0}" = "1" ]; then
    log=$(graphify update "$dest" --force 2>&1) || rc=$?
  else
    log=$(graphify update "$dest" 2>&1) || rc=$?
    if grep -q "Refusing to overwrite" <<<"$log" || [ ! -f "$out/graph.json" ]; then
      echo "  [$name] code was removed — full pass"
      rc=0
      log=$(graphify update "$dest" --force 2>&1) || rc=$?
    fi
  fi
  if [ "$rc" -ne 0 ] || [ ! -f "$out/graph.json" ]; then
    echo "  [$name] WARNING: graphify failed (exit $rc): $(tail -1 <<<"$log")" >&2
    echo "  [$name] the previous graph of this project stays; the next build of this project tries again" >&2
    [[ " $BUILD_ERRORS " == *" $name "* ]] || BUILD_ERRORS+=" $name"
    return 0
  fi
  printf '%s' "$manifest" > "$sig"
  return 0
}

build_graph() {
  require_cfg
  step "Building per-project graphs"
  local merge_inputs=() scip_specs=() sroot
  # Drop the staged copy of a project that left the config (or lost its code): the linkers walk all
  # of repos/, and a stale copy would give false edges. Direct children only; `rm -rf` on a symlink
  # removes the link, never what it points to.
  if [ -d "$KB_DATA/repos" ]; then
    local keep_repos=" " stale
    while IFS='|' read -r name code docs routes calls serves; do
      [ -n "$code" ] && keep_repos+="$name "
    done < <(read_projects)
    while IFS= read -r -d '' stale; do
      [[ "$keep_repos" == *" $(basename "$stale") "* ]] && continue
      echo "  [$(basename "$stale")] no longer a code project — removed its staged copy"
      rm -rf -- "$stale"
    done < <(find "$KB_DATA/repos" -mindepth 1 -maxdepth 1 -print0)
  fi
  while IFS='|' read -r name code docs routes calls serves; do
    [ -z "$name" ] && continue
    if [ -z "$code" ]; then
      echo "  [$name] docs-only — skipped from graph"
      continue
    fi
    stage_and_build "$name" "$code"
    if [ -f "$KB_DATA/repos/$name/graphify-out/graph.json" ]; then
      merge_inputs+=("$KB_DATA/repos/$name/graphify-out/graph.json")
    else
      echo "  [$name] error: no graph for this project yet — left out of the merged graph" >&2
      [[ " $BUILD_ERRORS " == *" $name "* ]] || BUILD_ERRORS+=" $name"
    fi
    if [ -n "$routes" ]; then
      # Route table feeds the frontend->controller edges. A silent failure here means the graph
      # quietly loses its cross-repo half, so say so instead of swallowing it.
      # LOG_CHANNEL=null: the indexed app must not get log files from this run (they would be owned
      # by the KB's user, and the app's own user could not append to them later).
      # A failed run keeps the previous table: routes change rarely, and a KB with last week's routes
      # is worth more than one with none (and the linker below needs the file).
      # A ready route table instead of artisan (a server without PHP, e.g. the Docker image): the file
      # $KB_ROUTES_DIR/<name>.json, or `routes` itself when it names a .json file. The app writes it
      # with `php artisan route:list --json` in its own container (docs/docker.md).
      local rfile="" how="php artisan route:list"
      if [ -n "${KB_ROUTES_DIR:-}" ] && [ -f "$KB_ROUTES_DIR/$name.json" ]; then rfile="$KB_ROUTES_DIR/$name.json"
      elif [ "${routes%.json}" != "$routes" ]; then rfile="$routes"; fi
      [ -n "$rfile" ] && how="reading the route table $rfile"
      # Both ways must give a JSON list: a PHP notice on stdout must not replace the last good table.
      if { { [ -n "$rfile" ] && cp "$rfile" "$KB_DATA/routes.$name.json.new"; } \
             || { [ -z "$rfile" ] && env -C "$routes" LOG_CHANNEL=null php artisan route:list --json >"$KB_DATA/routes.$name.json.new" 2>/dev/null; }; } \
         && "$PY" -c 'import json,sys; assert isinstance(json.load(open(sys.argv[1])), list)' "$KB_DATA/routes.$name.json.new" 2>/dev/null; then
        mv -f "$KB_DATA/routes.$name.json.new" "$KB_DATA/routes.$name.json"
      else
        rm -f "$KB_DATA/routes.$name.json.new"
        if [ -f "$KB_DATA/routes.$name.json" ]; then
          echo "  [$name] WARNING: $how failed — using the previous route table" >&2
        else
          echo "  [$name] WARNING: $how failed — HTTP edges for this repo will be missing" >&2
          echo "[]" >"$KB_DATA/routes.$name.json"
        fi
      fi
    fi
    # The project root for the SCIP add-on: the Laravel app when it has one, else the parent of the
    # first code folder (where composer.json, vendor/ or a ready index.scip live). A `routes` that
    # names a ready .json route table is no app folder.
    sroot="$routes"
    if [ -z "$sroot" ] || [ "${sroot%.json}" != "$sroot" ]; then sroot="$(dirname "${code%%,*}")"; fi
    scip_specs+=("$name=$sroot")
  done < <(read_projects)
  if [ "${#merge_inputs[@]}" -eq 0 ]; then
    if [ -n "$BUILD_ERRORS" ]; then
      echo "error: no project has a graph (failed:$BUILD_ERRORS)" >&2
      exit 1
    fi
    echo "    no code projects — graph steps skipped"
    mkdir -p "$OUT"
    build_contracts   # contract docs still reach connections and problems
    return 0
  fi

  # Everything below is a pure function of these inputs: the per-project manifests (staged code), the
  # route tables, the docs, the config and the KB's own code. When none changed, the merged graph from
  # the last run is still exact, and the 40-odd seconds of merging and post-processing are skipped.
  mkdir -p "$OUT"
  local post_sig post_file="$OUT/.kb-post-manifest" doc_roots=() mig_dirs=() mig_args=() m
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$docs" ] && [ -d "$docs" ] && doc_roots+=("$name=$docs")
  done < <(read_projects)
  while read -r m; do
    mig_dirs+=("$m"); mig_args+=(--migrations "$m")
  done < <(migration_dirs)
  post_sig=$( {
      for m in "${merge_inputs[@]}"; do echo "$m"; cat "$(dirname "$m")/.kb-manifest" 2>/dev/null || echo none; echo; done
      for m in "$KB_DATA"/routes.*.json "$KB_CONFIG/kb.projects.toml" "$KB_CONFIG/kb.hubs.txt" "$KB/kb.hubs.txt"; do
        [ -f "$m" ] && sha256sum "$m"
      done
      # the KB's own contract docs (build_contracts reads them)
      [ -d "$KB_DATA/docs/$CONTRACT_DIR" ] && find "$KB_DATA/docs/$CONTRACT_DIR" -type f -name '*.md' \
        -printf 'kb-contracts %P %s %T@\n' 2>/dev/null | LC_ALL=C sort
      for m in "${doc_roots[@]}"; do
        echo "$m"; find "${m#*=}" -type f -name '*.md' -not -path '*/node_modules/*' -not -path '*/.git/*' \
          -not -path '*/vendor/*' -printf '%P %s %T@\n' 2>/dev/null | LC_ALL=C sort
      done
      # the migrations that bin/link_data.py reads for the FK edges
      for m in "${mig_dirs[@]}"; do
        echo "$m"; find "$m" -type f -name '*.php' -printf '%P %s %T@\n' 2>/dev/null | LC_ALL=C sort
      done
      find "$KB/bin" -type f \( -name '*.py' -o -name kb \) -printf '%P %s %T@\n' | LC_ALL=C sort
      # the add-ons that change the graph (scip) and its ready indexes
      echo "scip=$("$PY" -c 'import sys; sys.path.insert(0, sys.argv[1]); import addons; print(addons.on("scip"))' "$KB/bin")"
      # A store file that bin/link_scip.py wrote comes from the staged code (already above), and this
      # build writes it again: leave it out, or no build is ever "unchanged". Line 2 of its <file>.key
      # is "<size> <mtime>" of the file (link_scip.store_is_derived). A store file without a matching
      # key is a ready index from the user, and it counts.
      for m in "$KB_DATA"/scip/*.scip; do
        [ -f "$m" ] || continue
        [ "$(sed -n 2p "$m.key" 2>/dev/null)" = "$(stat -c '%s %Y' "$m")" ] && continue
        echo "$m"; stat -c '%s %Y' "$m"
      done
      for m in "${scip_specs[@]}"; do
        if [ -f "${m#*=}/index.scip" ]; then echo "$m"; stat -c '%s %Y' "${m#*=}/index.scip"; fi
      done
    } | sha256sum)
  if [ "${BUILD_KIND:-}" != "build" ] && [ "${KB_FORCE:-0}" != "1" ] && [ -f "$OUT/graph.json" ] \
      && [ -f "$post_file" ] && [ "$(cat "$post_file")" = "$post_sig" ]; then
    echo "    Inputs unchanged — merged graph kept"
    return 0
  fi
  rm -f "$post_file"   # a run that dies half-way must not leave a signature that matches

  step "Merging into one cross-repo graph"
  # From here on graph.json is rewritten in place, step by step. Keep the last good one aside, so a
  # build that dies half-way does not leave a half-built graph for the tools to serve (keep_graph).
  if [ -f "$OUT/graph.json" ]; then
    cp -p "$OUT/graph.json" "$OUT/graph.json.prev"
    GRAPH_PREV="$OUT/graph.json.prev"
  fi
  if [ "${#merge_inputs[@]}" -ge 2 ]; then
    graphify merge-graphs "${merge_inputs[@]}" --out "$OUT/graph.json" >/dev/null
  else
    # a single-project KB is legitimate — merge-graphs needs >=2, so adopt the one graph and tag it the
    # way merge-graphs does (`repo`, ids `<repo>::<id>`): the linkers look nodes up by (repo, file).
    "$PY" "$KB/bin/graph.py" tag-repo "${merge_inputs[0]}" "$OUT/graph.json" \
      "$(basename "$(dirname "$(dirname "${merge_inputs[0]}")")")"
  fi

  step "Injecting HTTP edges (frontend -> controllers)"
  # re-walk config for calls/serves with their frontend roots
  while IFS='|' read -r name code docs routes calls serves; do
    [ -z "$calls" ] || [ -z "$serves" ] && continue
    IFS=',' read -ra fe <<< "$calls"
    # `serves` may list several APIs (a frontend that talks to its own backend and to a shared one):
    # each call site is matched against every listed route table.
    IFS=',' read -ra apis <<< "$serves"
    for api in "${apis[@]}"; do
      # --from: the calling project, so two projects with one relative path each get their edges.
      "$PY" "$KB/bin/link_http.py" --from "$name" "$OUT/graph.json" "$KB_DATA/routes.$api.json" "$api" "${fe[@]}"
    done
  done < <(read_projects)

  step "Canonicalizing duplicate symbol/reference nodes"
  "$PY" "$KB/bin/dedupe.py" "$OUT/graph.json"
  step "Decluttering framework god nodes (before clustering)"
  "$PY" "$KB/bin/declutter.py" "$OUT/graph.json" "$([ -f "$KB_CONFIG/kb.hubs.txt" ] && echo "$KB_CONFIG/kb.hubs.txt" || echo "$KB/kb.hubs.txt")"
  step "Clustering (locks final community ids)"
  graphify cluster-only "$KB_DATA" --no-label >/dev/null
  step "Labeling communities by namespace/domain"
  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json" | head -1
  step "Re-rendering report + full visualization with labels"
  # Clustering and labeling are mutually dependent THROUGH FILES: `cluster-only` can renumber
  # community ids, while the labels file is keyed by those ids. So this is a two-step fixpoint, not a
  # redundant call: label (ids from pass 1) -> re-render with labels (ids may shift) -> label again.
  # Keep both passes; if a third were ever needed the dependency should be expressed instead.
  graphify cluster-only "$KB_DATA" --no-label >/dev/null
  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json" >/dev/null

  step "Enriching with node types, domains, db_table nodes + domain anchors"
  "$PY" "$KB/bin/enrich.py" "$OUT/graph.json" "$KB_DATA/repos"
  step "Adding data-layer links (eloquent model rels, FK table->table, SQL code->table)"
  # --migrations <dir>, once per folder: the FK edges come from there, wherever the config lives.
  "$PY" "$KB/bin/link_data.py" "$OUT/graph.json" "$KB_DATA/repos" "${mig_args[@]}"
  # Add-on `scip` (off by default): precise calls from a SCIP index. Before the typed-call linker,
  # so that one does not add an INFERRED copy of an edge the index proves.
  "$PY" "$KB/bin/link_scip.py" "$OUT/graph.json" "$KB_DATA/repos" "${scip_specs[@]}"
  step "Linking PHP calls through typed variables and properties"
  "$PY" "$KB/bin/link_php_calls.py" "$OUT/graph.json" "$KB_DATA/repos"
  # Docs as graph nodes (bin/lang/markdown.py): [[wikilink]] and relative links are EXTRACTED edges,
  # a bare symbol mention is INFERRED and capped. Runs after the code plugins — it points at their nodes.
  if [ "${#doc_roots[@]}" -gt 0 ]; then
    step "Linking docs into the graph (${#doc_roots[@]} doc roots)"
    "$PY" "$KB/bin/link_docs.py" "$OUT/graph.json" "${doc_roots[@]}"
  fi
  step "Mining rationale comments (NOTE/WHY/HACK/SECURITY -> rationale nodes)"
  "$PY" "$KB/bin/link_rationale.py" "$OUT/graph.json" "$KB_DATA/repos"
  step "Rendering custom typed/domain visualization"
  "$PY" "$KB/bin/render_viz.py" "$OUT/graph.json" "$OUT"
  rm -f "$OUT/kb-graph.html"   # 0.5.0: the shell moved to web/; drop the stale generated page
  echo "    graphify graph.html (raw upstream view) -> $OUT · shell: web/index.html"
  build_contracts
  printf '%s' "$post_sig" > "$post_file"
  rm -f "$GRAPH_PREV"; GRAPH_PREV=""
}

# The contract layer (bin/contracts.py): routes joined with their frontend call sites, the service
# map from <docs>/contracts/*.md, and the gaps between the two. Read by contracts_search,
# connections and problems; built after the graph because it reads its http_request edges.
build_contracts() {
  local specs=() docs_specs=() prob_specs=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$routes" ] && [ -f "$KB_DATA/routes.$name.json" ] && specs+=("$name=$KB_DATA/routes.$name.json")
    [ -n "$docs" ] && [ -d "$docs" ] && docs_specs+=("$name=$docs") && prob_specs+=("docs:$name=$docs")
    [ -n "$routes" ] && prob_specs+=("routes:$name=$KB_DATA/routes.$name.json")
    [ -n "$calls" ] && [ -n "$serves" ] && prob_specs+=("calls:$name=$serves=$calls")
  done < <(read_projects)
  # The KB service's own contract docs, if this checkout has any (<data>/docs/contracts/).
  [ -d "$KB_DATA/docs/$CONTRACT_DIR" ] && docs_specs+=("$SELF_DOCS=$KB_DATA/docs")
  step "Building the contract index (routes + frontend call sites)"
  if [ -f "$OUT/graph.json" ]; then
    "$PY" "$KB/bin/contracts.py" contracts "$OUT/graph.json" "$OUT/contracts.json" "${specs[@]}"
  else
    echo "[]" >"$OUT/contracts.json"   # no code graph (a docs-only KB): no routes and no call sites
    echo "    no graph — no contracts from code"
  fi
  step "Building the connection map (contract docs + HTTP calls)"
  "$PY" "$KB/bin/contracts.py" connections "$OUT/contracts.json" "$OUT/connections.json" "${docs_specs[@]}"
  step "Finding problems (contract docs, unknown routes)"
  "$PY" "$KB/bin/contracts.py" problems "$OUT/connections.json" "$OUT/problems.json" "${prob_specs[@]}"
}

# Where qmd gets its vector embeddings. Resolved once and remembered in .kb.local.
#   none  - skip vectors; BM25 keyword search only (no model download)
#   llama - on-device llama.cpp embeddings (qmd default; downloads a small GGUF model)
#   other - bring your own: runs $KB_QMD_EMBED_CMD if set, else plain `qmd embed`
#           (point qmd at your own model/endpoint via its env)
# Precedence: KB_QMD_BACKEND env > persisted QMD_BACKEND > interactive prompt > llama.
resolve_qmd_backend() {
  local b="${KB_QMD_BACKEND:-${QMD_BACKEND:-}}"
  if [ -z "$b" ]; then
    if [ -t 0 ]; then
      {
        echo "Where should qmd plug its embeddings?"
        echo "  none  - skip vectors; BM25 keyword search only (no model download)"
        echo "  llama - on-device llama.cpp embeddings (qmd default; downloads a small model)"
        echo "  other - configure qmd yourself, or set KB_QMD_EMBED_CMD"
      } >&2
      local ans; read -rp "  [none|llama|other] (llama): " ans </dev/tty || ans=""
      b="${ans:-llama}"
    else
      b="llama"   # non-interactive (CI, hooks): default to the on-device backend
    fi
  fi
  case "$b" in none|llama|other) ;; *) b="llama" ;; esac
  # persist the resolved choice (env override is not persisted — it's a one-off)
  if [ -z "${KB_QMD_BACKEND:-}" ] && [ "${QMD_BACKEND:-}" != "$b" ]; then
    printf 'QMD_BACKEND=%s\n' "$b" > "$LOCAL_CFG"
  fi
  QMD_BACKEND="$b"
  echo "$b"
}

qmd_embed() {
  local b; b="$(resolve_qmd_backend)"
  case "$b" in
    none)  echo "    qmd backend=none — skipping embeddings (BM25 keyword search only)" ;;
    other) if [ -n "${KB_QMD_EMBED_CMD:-}" ]; then
             echo "    qmd backend=other — running KB_QMD_EMBED_CMD"; eval "$KB_QMD_EMBED_CMD" || true
           else
             echo "    qmd backend=other — running 'qmd embed' (configure qmd's model/endpoint via its env)"
             qmd embed 2>/dev/null || true
           fi ;;
    llama) qmd embed 2>/dev/null || true ;;
  esac
}

# rsync protect rules for the extracted docs: "P *.[pP][dD][fF].md" and so on, one per format that
# the find in build_kb hands to bin/extract. Case-blind, like `find -iname`.
EXTRACTED_PROTECT=()
for _ext in pdf docx odt rtf epub png jpg jpeg tif tiff; do
  _glob=""
  for (( _i = 0; _i < ${#_ext}; _i++ )); do _c="${_ext:_i:1}"; _glob+="[${_c}${_c^^}]"; done
  EXTRACTED_PROTECT+=("--filter=P *.${_glob}.md")
done
unset _ext _glob _i _c

build_kb() {
  require_cfg
  step "Staging + indexing docs into qmd collection '$COLLECTION'"
  [ -d "$KB/.qmd" ] || qmd init >/dev/null 2>&1 || true
  # Every project's docs are staged under $DOCS_STAGE/<project>/ (one qmd collection each, below).
  # rsync --delete in place, never rm -rf first: a search during a rebuild still finds the docs.
  mkdir -p "$DOCS_STAGE"
  local staged=0 keep=()
  local roots=()
  while IFS='|' read -r name code docs routes calls serves; do
    [ -n "$docs" ] && [ -d "$docs" ] && roots+=("$name|$docs")
  done < <(read_projects)
  [ -d "$KB_DATA/docs" ] && roots+=("$SELF_DOCS|$KB_DATA/docs")
  local root name docs
  for root in "${roots[@]}"; do
    name="${root%%|*}"; docs="${root#*|}"
    keep+=("$name")
    mkdir -p "$DOCS_STAGE/$name"
    # --safe-links: a symlink that points out of the docs tree is not staged (report.md -> a secret).
    # The protect rules (P) keep the extracted files (<file>.<ext>.md, below) from --delete, so an
    # unchanged PDF is not extracted again on every run; bin/extract removes the stale ones itself.
    # A folder that holds only extracted files cannot be deleted (they are protected): rsync says so
    # on every build, and it is expected, so that line is dropped.
    { rsync -a --delete --prune-empty-dirs --safe-links "${EXTRACTED_PROTECT[@]}" \
      --exclude='node_modules/' --exclude='.git/' --exclude='vendor/' \
      --include='*/' --include='*.md' --exclude='*' \
      "$docs/" "$DOCS_STAGE/$name/" 2>/dev/null || true; } | { grep -v '^cannot delete non-empty directory: ' || true; }
    # Non-markdown documents (PDF, docx, scans) are extracted into the same staged tree, so the doc
    # index sees them too: docs/guide.pdf becomes docs/guide.pdf.md. One parser per format lives in
    # bin/parsers/; a format whose external tool is absent is reported and skipped, never fatal.
    # Extracted files carry a provenance header, so an OCR'd scan is never mistaken for authored
    # text. bin/extract skips a source whose size and mtime did not change, and --prune removes the
    # extract of a deleted source. KB_EXTRACT=0 switches extraction off and removes the extracts.
    if [ "${KB_EXTRACT:-1}" != "0" ]; then
      # An unreadable folder under the docs root makes find exit 1: warn and go on, so the other
      # projects' docs and the qmd update still run. Without a full list, --prune is left out: the
      # extracts of the unreadable folder stay until it can be read again.
      local find_rc=0 list prune=--prune
      list="$(mktemp)"
      find "$docs" -type f \( -iname '*.pdf' -o -iname '*.docx' -o -iname '*.odt' -o -iname '*.rtf' \
        -o -iname '*.epub' -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.tif' -o -iname '*.tiff' \) \
        -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/vendor/*' -print0 \
        >"$list" 2>/dev/null || find_rc=$?
      if [ "$find_rc" -ne 0 ]; then
        echo "  [$name] warning: some folders under $docs could not be read (find exit $find_rc); their documents are left out" >&2
        prune=""
      fi
      if [ -n "$prune" ] || [ -s "$list" ]; then
        { "$PY" "$KB/bin/extract" --into "$DOCS_STAGE/$name" --root "$docs" $prune --from0 <"$list" 2>&1 || true; } \
          | sed 's/^/    /'
      fi
      rm -f "$list"
    else
      "$PY" "$KB/bin/extract" --into "$DOCS_STAGE/$name" --root "$docs" --prune </dev/null 2>&1 | sed 's/^/    /'
    fi
    echo "  [$name] staged $(find "$DOCS_STAGE/$name" -name '*.md' | wc -l) docs"
    staged=1
  done
  # drop the staged docs of a project that left kb.projects.toml
  local d
  for d in "$DOCS_STAGE"/*/; do
    [ -d "$d" ] || continue
    [[ " ${keep[*]} " == *" $(basename "$d") "* ]] || rm -rf "$d"
  done
  [ "$staged" = 1 ] || { echo "  (no docs configured)"; return; }
  # One qmd collection per project ($COLLECTION-<project>), so a search can be scoped to one project
  # and the rest of the network stays out of its results. Searching all projects = all collections.
  # The pre-0.11 single aggregated collection "$COLLECTION" and collections of projects dropped from
  # the config are removed here.
  local want=() n have
  for n in "$DOCS_STAGE"/*/; do want+=("$COLLECTION-$(basename "$n")"); done
  # Each qmd call starts a process (~1 s). When qmd already has exactly the wanted collections, the
  # remove/show/add round below is skipped; one `collection list` is enough to know.
  have=$(qmd collection list 2>/dev/null | awk -v p="$COLLECTION" '$1==p || index($1,p"-")==1{print $1}' | LC_ALL=C sort | tr '\n' ' ')
  if [ "$have" = "$(printf '%s\n' "${want[@]}" | LC_ALL=C sort | tr '\n' ' ')" ] \
      && [ -f "$DOCS_STAGE/.kb-collections" ] && [ "$(cat "$DOCS_STAGE/.kb-collections")" = "$have" ]; then
    want=()
  fi
  [ "${#want[@]}" -gt 0 ] && qmd collection remove "$COLLECTION" >/dev/null 2>&1 || true
  [ "${#want[@]}" -gt 0 ] && while read -r n; do
    [[ " ${want[*]} " == *" $n "* ]] || qmd collection remove "$n" >/dev/null 2>&1 || true
  done < <(qmd collection list 2>/dev/null | awk -v p="$COLLECTION-" 'index($1,p)==1{print $1}')
  [ "${#want[@]}" -gt 0 ] && for n in "$DOCS_STAGE"/*/; do
    n="$(basename "$n")"
    local cur; cur="$(qmd collection show "$COLLECTION-$n" 2>/dev/null | awk -F': *' '/Path:/{print $2; exit}' || true)"
    if [ "$cur" != "$DOCS_STAGE/$n" ]; then
      qmd collection remove "$COLLECTION-$n" >/dev/null 2>&1 || true
      qmd collection add "$DOCS_STAGE/$n" --name "$COLLECTION-$n" >/dev/null 2>&1 || true
    fi
  done
  qmd collection list 2>/dev/null | awk -v p="$COLLECTION" 'index($1,p"-")==1{print $1}' | LC_ALL=C sort \
    | tr '\n' ' ' > "$DOCS_STAGE/.kb-collections"
  qmd update 2>/dev/null || true
  qmd_embed
  [ "${BUILD_KIND:-}" = "update" ] || qmd status || true   # `kb update` discards this output anyway
}

# Optional add-ons, named by what they do (bin/addons.py has the list). `install` fetches what one needs
# and switches it on; `remove` switches it off (and deletes what it fetched). Off = no tool, no page.
addon() {
  local action="$1" name="$2" sb="$KB_DATA/sandbox" gpy gver
  gpy="$(head -1 "$(readlink -f "$(command -v graphify 2>/dev/null || echo /nonexistent)")" 2>/dev/null | sed 's/^#!//')"
  gver="$(graphify --version 2>/dev/null | awk '{print $2}')"
  if [ "$name" = admin ] && { [ "$action" = install ] || [ "$action" = remove ]; }; then
    echo "admin: the admin pages are part of the core now (always on; the shared server needs KB_ADMINS, admins.txt or an access plugin with roles). Nothing to $action."
    return 0
  fi
  case "$action" in
    list) "$PY" "$KB/bin/addons.py" list ;;
    install)
      if [ -d "$name" ] && [ -f "$name/plugin.py" ]; then   # an external add-on (bin/plugins.py)
        local pname; pname="$(basename "$(cd "$name" && pwd -P)")"
        mkdir -p "$KB_DATA/plugins"
        ln -sfn "$(cd "$name" && pwd -P)" "$KB_DATA/plugins/$pname"
        "$PY" "$KB/bin/addons.py" on "$pname" && echo "$pname: plugin on (restart the KB server to load it)"
        return 0
      fi
      case "$name" in
        code-mode)
          command -v node >/dev/null && command -v npm >/dev/null || { echo "code-mode needs Node 22+ and npm" >&2; exit 1; }
          mkdir -p "$sb"
          if [ "$(cd "$sb" && pwd -P)" != "$(cd "$KB_PACKAGE/sandbox" && pwd -P)" ]; then  # a checkout installs in place
            cp "$KB_PACKAGE/sandbox/package.json" "$KB_PACKAGE/sandbox/package-lock.json" "$KB_PACKAGE/sandbox/runner.mjs" "$sb/"
          fi
          (cd "$sb" && npm ci --ignore-scripts --no-audit --no-fund) ;;
        fast-routes)
          if [ -n "$gpy" ] && "$gpy" -c "import rustworkx" 2>/dev/null; then :
          elif command -v uv >/dev/null && uv tool list 2>/dev/null | grep -q '^graphifyy'; then
            uv tool install "graphifyy==$gver" --with rustworkx --reinstall
          elif command -v pipx >/dev/null; then pipx inject graphifyy rustworkx
          else echo "install rustworkx into graphify's environment: $gpy -m pip install rustworkx" >&2; exit 1; fi ;;
        tool-multicall|metrics|audit|questions|datadict) : ;;   # nothing to fetch
        scip)   # the indexer is the user's to install (docs/tools.md, "SCIP"); say when none is found
          if [ -z "${KB_SCIP_PHP:-}" ] && ! command -v scip-php >/dev/null; then
            echo "  no scip-php on the PATH and no KB_SCIP_PHP: only ready index.scip files will be read"
          fi ;;
        *) echo "kb addon install <name>: $(sed -n 's/^    "\([a-z-]*\)": .*/\1/p' "$KB/bin/addons.py" | tr '\n' ' ')" >&2; exit 1 ;;
      esac
      "$PY" "$KB/bin/addons.py" on "$name" && echo "$name: on (restart the KB server to load it)" ;;
    remove)
      "$PY" "$KB/bin/addons.py" off "$name" && echo "$name: off"
      if [ -L "$KB_DATA/plugins/$name" ]; then rm -f "$KB_DATA/plugins/$name" && echo "  plugin link removed"; fi
      if [ "$name" = code-mode ]; then rm -rf "$sb/node_modules" && echo "  sandbox packages removed from $sb"; fi ;;
    *) echo "kb addon {list|install <name>|remove <name>}" >&2; exit 1 ;;
  esac
}

# The end of a build: exit non-zero when a project kept its previous graph (BUILD_ERRORS).
fail_loud() {
  [ -z "$BUILD_ERRORS" ] && return 0
  echo "error: these projects kept their previous graph:$BUILD_ERRORS (see the errors above)" >&2
  exit 1
}

case "${1:-build}" in
  --version|-V|version)
          echo "knowledge-index $KB_VERSION"
          echo "  graphify: $(graphify --version 2>/dev/null || echo 'not found')"
          echo "  qmd:      $(qmd --version 2>/dev/null || echo 'not found')"
          "$PY" "$KB/bin/paths.py" | sed 's/^/  /'
          ;;
  build)  BUILD_START=$(date +%s); BUILD_KIND=build; build_graph; build_kb; "$PY" "$KB/bin/plugins.py" build; fail_loud ;;
  graph)  BUILD_START=$(date +%s); BUILD_KIND=graph; build_graph; fail_loud ;;
  kb)     build_kb ;;
  update) BUILD_START=$(date +%s); BUILD_KIND=update; build_graph; build_kb >/dev/null; "$PY" "$KB/bin/plugins.py" build
          fail_loud; echo "refreshed" ;;
  qmd-backend) rm -f "$LOCAL_CFG"; unset QMD_BACKEND; echo "qmd backend set to: $(resolve_qmd_backend)" ;;
  label)  "$PY" "$KB/bin/label_namespaces.py" "$OUT/graph.json" "$OUT/.graphify_labels.json"
          graphify cluster-only "$KB_DATA" --no-label >/dev/null; echo "relabeled + report regenerated" ;;
  vendor) "$PY" -c "import sys; sys.path.insert(0,'$KB/bin'); import paths; print(paths.stage_web())" >/dev/null
          W="$KB_WEB"; mkdir -p "$W/vendor"
          # Pinned to the version that web/ is tested with; an unpinned URL changes under us.
          curl -fsSL https://unpkg.com/vis-network@10.1.0/standalone/umd/vis-network.min.js \
            -o "$W/vendor/vis-network.min.js" &&
            echo "vendored $W/vendor/vis-network.min.js — the dashboard now works offline" ;;
  open)   W="$KB_WEB"; [ -f "$W/index.html" ] || "$PY" -c "import sys;sys.path.insert(0,'$KB/bin');import paths;paths.stage_web()"
          xdg-open "$W/index.html" 2>/dev/null || echo "open $W/index.html" ;;
  status) graphify diagnose multigraph --graph "$OUT/graph.json" | head -8; echo; qmd status ;;
  addon) addon "${2:-list}" "${3:-}" ;;
  *) echo "usage: kb {build|graph|kb|update|label|status|open|vendor|qmd-backend|addon|--version}"; exit 1 ;;
esac
