#!/usr/bin/env bash
# Rebuild the KB (`kb update`: graph, contracts, docs) when an indexed checkout has a new HEAD.
# Meant for a server's cron, every minute; a tick without a new commit costs a few `git rev-parse`.
#
# Usage: bin/kb-refresh [--force]
#
# - The git checkouts come from the absolute paths in kb.projects.toml.
# - One build at a time: a flock on <data>/logs/update.lock. A tick during a build exits at once.
# - KB_REFRESH_WAIT_LOCK=<file>: when set and readable, a tick exits while another process holds
#   that lock (e.g. your deploy script resetting the checkouts). The next tick builds. Unset = no wait.
# - The HEADs of the last build go to logs/heads.txt, also after a failed build: a broken build does
#   not repeat every minute; the next commit or --force retries it.
# - logs/update.log holds the output of the last build; logs/refresh.log one line per build.
set -euo pipefail

BIN="$(cd "$(dirname "$0")" && pwd)"
eval "$(python3 "$BIN/paths.py" --sh)"
cd "$KB_DATA"
mkdir -p logs
# graphify and qmd usually live in ~/.local/bin (uv tool, npm prefix); cron does not add it.
export PATH="$HOME/.local/bin:$PATH"
CFG="$KB_CONFIG/kb.projects.toml"
STAMP="$KB_DATA/logs/heads.txt"
WAIT_LOCK="${KB_REFRESH_WAIT_LOCK:-}"

# The lock is the flock(2) on <data>/logs/update.lock, not the file. The file stays after a build and
# its presence means nothing: a build runs while a process holds the flock (fd 8, released when this
# script exits, also on a crash). To ask "is a build running?", try the lock, for example
# `flock -n <data>/logs/update.lock true` (exit 1 = running), never test whether the file exists.
exec 8>"$KB_DATA/logs/update.lock"
flock -n 8 || exit 0

if [ -n "$WAIT_LOCK" ] && [ -r "$WAIT_LOCK" ]; then
  exec 7<"$WAIT_LOCK"
  flock -n -s 7 || exit 0
  exec 7<&-  # release at once: holding it would make the other process skip its own ticks
fi

# Every path of kb.projects.toml (code, docs, routes, calls), read with tomllib like bin/kb does.
# A missing or broken file prints one line "error: ..." on stderr and exits 1, no traceback.
config_paths() { python3 - "$CFG" <<'PY'
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as fh:
        projects = tomllib.load(fh).get("project", [])
    if not isinstance(projects, list) or not all(isinstance(p, dict) for p in projects):
        raise ValueError("use [[project]] blocks")
except Exception as e:  # noqa: BLE001 - any reason: one line for the logs, not a traceback
    sys.exit(f"error: {sys.argv[1]}: {e}".replace("\n", " "))
for p in projects:
    for k in ("code", "docs", "routes", "calls"):
        v = p.get(k) or []
        for x in [v] if isinstance(v, str) else v:
            if isinstance(x, str) and x.startswith("/"):
                print(x)
PY
}

# A broken config: one line in update.log (the admin's Rebuild view) and in refresh.log, and a
# non-zero exit. Nothing on stdout or stderr: cron would mail it every minute. The same error goes
# into refresh.log once, not on every tick.
if ! paths=$(config_paths 2>&1); then
  msg="exit=1 config error: $(tail -1 <<<"$paths")"
  echo "$(date '+%F %T') $msg" >logs/update.log
  if [ "$(tail -1 logs/refresh.log 2>/dev/null | cut -d' ' -f3-)" != "$msg" ]; then
    echo "$(date '+%F %T') $msg" >>logs/refresh.log
  fi
  exit 1
fi

heads() {
  local p top
  printf '%s\n' "$paths" | while read -r p; do
    [ -d "$p" ] || continue
    top=$(git -C "$p" rev-parse --show-toplevel 2>/dev/null) || continue
    echo "$top"
  done | sort -u | while read -r top; do
    echo "$top $(git -C "$top" rev-parse HEAD 2>/dev/null || echo unknown)"
  done
}

now=$(heads)
if [ "${1:-}" != "--force" ] && [ "$now" = "$(cat "$STAMP" 2>/dev/null || true)" ]; then
  exit 0
fi

start=$(date +%s)
status=0
# nice 19: qmd embed takes every core; whatever else runs on the server goes first.
{ date; echo "$now"; nice -n 19 "$BIN/kb" update; } >logs/update.log 2>&1 || status=$?
echo "$now" >"$STAMP"
echo "$(date '+%F %T') exit=$status $(( $(date +%s) - start ))s $(echo "$now" | awk '{printf "%s@%.9s ", $1, $2}')" \
  >>logs/refresh.log
exit "$status"
