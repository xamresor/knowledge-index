#!/usr/bin/env python3
"""Extract documents that are not markdown into markdown, so the doc index can see them.

    kb-extract <file> [...]            print the extracted markdown (with provenance) to stdout
    kb-extract --into <dir> [--root <docs>] [--prune] [--from0] <file>...
                                       write <dir>/<path>.md instead (bin/kb uses this)
    kb-extract --list                  which formats can be extracted on this machine, and why not

--into writes each file to <dir>/<path relative to --root><suffix>.md, e.g. docs/guide.pdf becomes
<dir>/docs/guide.pdf.md: the suffix stays, so guide.pdf never overwrites an authored guide.md, and
a/x.pdf and b/x.pdf stay apart. Without --root the path is the bare file name. --from0 reads more
file names from stdin, separated by NUL (find -print0). A file whose size and mtime did not change
is not extracted again: <dir>/.kb-extracted.json remembers what was written, and also a file whose
extraction failed, so a broken PDF is tried again only when it changes or a new parser for it is
installed. When a parser cannot read a file (a PDF without a text layer), the next one tries (OCR).
A timeout is not remembered: the next run tries again, and the old text stays until then. A source
over KB_EXTRACT_MAX_MB (default 200) is skipped. --prune removes the
files written by an earlier run whose source is not in this run. A write never follows a symlink:
it goes to a temp file and replaces the target, and a target outside <dir> is refused.

Design: one parser per format in bin/parsers/, each a thin wrapper over an external CLI. A missing tool
means the format is unsupported — reported, never fatal. Every output carries a provenance header, so
an OCR'd scan can never be mistaken for something a human wrote.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import parsers

MANIFEST = ".kb-extracted.json"   # in the --into dir: target -> source, size, mtime, parser
_STAMP = re.compile(r"(?m)^extracted_at: .*$")
DEFAULT_MAX_MB = 200               # KB_EXTRACT_MAX_MB: a larger source is not extracted


def _max_bytes() -> float:
    try:
        return float(os.environ.get("KB_EXTRACT_MAX_MB", DEFAULT_MAX_MB)) * 2**20
    except ValueError:
        return DEFAULT_MAX_MB * 2**20


def _parser_name(module) -> str:
    return module.__name__.rsplit(".", 1)[-1]


def _inside(path: Path, root: Path) -> bool:
    """True when the real path of `path` lies under the real path of `root`."""
    real, base = os.path.realpath(path), os.path.realpath(root)
    return real == base or real.startswith(base + os.sep)


def _write(target: Path, text: str, into: Path) -> None:
    """Write without following a symlink: a temp file in the target folder, then os.replace."""
    existing = target.parent
    while not existing.exists():
        existing = existing.parent
    if not _inside(existing, into):         # checked before mkdir, so no folder is made outside
        raise OSError(f"{target} is outside {into}")
    target.parent.mkdir(parents=True, exist_ok=True)
    if not _inside(target.parent, into):
        raise OSError(f"{target} is outside {into}")
    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=".kb-extract-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, target)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def _load_manifest(into: Path) -> dict:
    path = into / MANIFEST
    if path.is_symlink() or not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _remove(target: Path, into: Path) -> None:
    """Remove a file written by an earlier run. A symlinked folder on the way is not followed."""
    if _inside(target.parent, into) and (target.is_symlink() or target.is_file()):
        target.unlink()


def _target(path: Path, root: Path | None, into: Path) -> Path | None:
    """<into>/<path relative to root>.md, or None when the source lies outside the root."""
    if root is None:
        return into / (path.name + ".md")
    try:
        rel = Path(os.path.abspath(path)).relative_to(os.path.abspath(root))
    except ValueError:
        return None
    return into / (str(rel) + ".md")


def main(argv: list[str]) -> int:
    args = list(argv)
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2

    if args[0] == "--list":
        ready = parsers.available()
        table = parsers.registry()
        print("formats:")
        for ext in sorted(table):
            if ext in ready:
                print(f"  {ext:7} -> {ready[ext]}")
            else:
                needs = sorted({t for m in table[ext] for t in m.REQUIRES})
                print(f"  {ext:7} -- unsupported here: install {', '.join(needs)}")
        return 0

    into: Path | None = None
    root: Path | None = None
    prune = from0 = False
    if args[0] == "--into":
        if len(args) < 2:
            print("--into needs a directory", file=sys.stderr)
            return 2
        into = Path(args[1])
        into.mkdir(parents=True, exist_ok=True)
        args = args[2:]
        while args and args[0] in ("--root", "--prune", "--from0"):
            flag = args.pop(0)
            if flag == "--root":
                if not args:
                    print("--root needs a directory", file=sys.stderr)
                    return 2
                root = Path(args.pop(0))
            elif flag == "--prune":
                prune = True
            else:
                from0 = True
        if from0:
            args += [n for n in sys.stdin.read().split("\0") if n]
        if not args and not prune:
            print("--into needs at least one file", file=sys.stderr)
            return 2
    if into is None:
        return _to_stdout(args)

    manifest, kept = _load_manifest(into), {}
    for name in args:
        path = Path(name)
        if path.is_symlink() or not path.is_file():
            print(f"skip {name}: not a regular file", file=sys.stderr)
            continue
        target = _target(path, root, into)
        if target is None:
            print(f"skip {name}: outside {root}", file=sys.stderr)
            continue
        key = str(target.relative_to(into))
        if root is not None and (root / key).exists():
            print(f"skip {path.name}: the authored {key} has the same name", file=sys.stderr)
            continue
        st = path.stat()
        mods = parsers.runnable(path)
        # The parsers that could run, by name: a cached failure or a kept text is reused only while
        # this set is the same, so installing tesseract retries a scan that pdftotext could not read.
        tried = "+".join(_parser_name(m) for m in mods)
        old = manifest.get(key) or {}
        same = old.get("size") == st.st_size and old.get("mtime_ns") == st.st_mtime_ns
        old_set = old.get("parsers", old.get("parser"))
        if same and old.get("failed") and mods and old_set == tried:
            kept[key] = old                 # failed before and unchanged since: do not try every build
            continue
        if (same and not old.get("failed") and (not mods or old_set == tried)
                and target.is_file() and not target.is_symlink()):
            kept[key] = old                 # unchanged since the last run: keep the text as it is
            continue
        if not mods:
            needed = parsers.MISSING_TOOLS.get(path.suffix.lower())
            why = f"install {', '.join(needed)}" if needed else "no parser for this format"
            print(f"skip {path.name}: {why}", file=sys.stderr)
            continue
        if st.st_size > _max_bytes():
            print(f"skip {path.name}: {st.st_size // 2**20} MB is over KB_EXTRACT_MAX_MB "
                  f"({os.environ.get('KB_EXTRACT_MAX_MB', DEFAULT_MAX_MB)})", file=sys.stderr)
            _remove(target, into)           # not remembered: a raised limit takes effect at once
            continue
        # Best parser first; an ExtractError ("no text layer, needs OCR") goes on to the next one.
        text, module, errors, transient = None, None, [], False
        for candidate in mods:
            try:
                text = parsers.with_provenance(candidate.extract(path), path, candidate)
                module = candidate
                break
            except parsers.TransientError as exc:
                transient = True
                errors.append(str(exc))
            except parsers.ExtractError as exc:
                errors.append(str(exc))
            except (OSError, subprocess.SubprocessError) as exc:   # a parser that let one through
                transient = True
                errors.append(f"{_parser_name(candidate)}: {exc}")
        if module is None:
            why = "; ".join(errors)
            if transient:
                # A timeout says nothing about the file: no failure is remembered, and the old text
                # stays (with its old manifest entry) until a run reads the file.
                print(f"skip {path.name}: {why} (tried again on the next run)", file=sys.stderr)
                if old:
                    kept[key] = old
                continue
            print(f"skip {path.name}: {why} (not tried again until the file changes or a parser is added)",
                  file=sys.stderr)
            # The text of the earlier version no longer describes the file: it leaves the index. The
            # failure is remembered for this size, mtime and set of parsers only.
            _remove(target, into)
            kept[key] = {"source": os.path.abspath(path), "size": st.st_size, "mtime_ns": st.st_mtime_ns,
                         "parsers": tried, "failed": why[:200]}
            continue
        # The source mtime, not the clock: the same source gives the same text, so the doc index
        # does not embed it again on every build.
        stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime))
        text = _STAMP.sub(lambda _m: f"extracted_at: {stamp}", text, count=1)
        try:
            _write(target, text, into)
        except OSError as exc:
            print(f"skip {path.name}: cannot write {target}: {exc}", file=sys.stderr)
            continue
        kept[key] = {"source": os.path.abspath(path), "size": st.st_size, "mtime_ns": st.st_mtime_ns,
                     "parser": _parser_name(module), "parsers": tried}
        print(f"{path.name} -> {target}  ({len(text)} chars, {module.CONFIDENCE})")
    if prune:
        for key in set(manifest) - set(kept):
            if root is None or not (root / key).exists():     # never an authored file of that name
                _remove(into / key, into)
    else:
        kept = {**manifest, **kept}
    _write(into / MANIFEST, json.dumps(kept, indent=1, sort_keys=True) + "\n", into)
    return 0


def _to_stdout(args: list[str]) -> int:
    failures = 0
    for name in args:
        path = Path(name)
        if not path.is_file():
            print(f"skip {name}: not a file", file=sys.stderr)
            failures += 1
            continue
        mods = parsers.runnable(path)
        if not mods:
            needed = parsers.MISSING_TOOLS.get(path.suffix.lower())
            why = f"install {', '.join(needed)}" if needed else "no parser for this format"
            print(f"skip {path.name}: {why}", file=sys.stderr)
            failures += 1
            continue
        errors = []
        for module in mods:                 # best first; the next one after an ExtractError
            try:
                sys.stdout.write(parsers.with_provenance(module.extract(path), path, module))
                break
            except parsers.ExtractError as exc:
                errors.append(str(exc))
        else:
            print(f"skip {path.name}: {'; '.join(errors)}", file=sys.stderr)
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
