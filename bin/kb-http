#!/usr/bin/env python3
"""Shared MCP server over HTTP — so **a team** can query one index. Off by default.

Why it exists
-------------
`kb-mcp` serves one person's agent over stdio; `kb-api` serves scripts on loopback. A team wants one
build on one server, reached by every developer's agent, where each developer sees only the projects
they are allowed to see. That needs a network transport *and* identity, and identity is something
this tool must not invent: it asks an endpoint you already run.

Transport: MCP "streamable HTTP", JSON answers only. POST /mcp with one JSON-RPC message or a batch.
Methods: initialize, notifications/initialized, tools/list, tools/call, ping. GET /mcp -> 405 (no SSE).
The tools are the core's (`kb_core.TOOLS`) plus `usage`; every call goes through `kb_core.call_tool`
with the caller's project set, so the access filter lives in one place (bin/access.py).

Auth: access protocol v1 (docs/access-protocol.md). Every request carries `Authorization: Bearer
<token>`. The server POSTs to $KB_PERMISSION_URL with that token and {"protocol": 1, "projects": [...]}
(the projects of kb.projects.toml) and expects 200 with
    {"user": {"name"|"uname"|"username"|"id"|"uid": ...}, "projects": [subset] | "*"}
Mapping:
    no / malformed Authorization header  -> 401 + WWW-Authenticate: Bearer
    webhook 200                          -> allowed, projects = answer.projects ("*" = all)
    webhook 401                          -> 401
    webhook 403/404/other 4xx            -> 403
    webhook 5xx / unreachable / bad body -> 503 (never cached)
    empty project list                   -> 403
    a malformed token (over 4096 characters, a space or a character that is no printable ASCII) -> 401,
    without a webhook call
    more than KB_AUTH_MAX_CHECKS (16) webhook checks at once, after KB_AUTH_CHECK_WAIT (2) s -> 503 busy
The verdict, a refusal too, is cached KB_AUTH_CACHE_SECONDS per SHA-256 of the token; the token is never
logged. An access token of the browser sign-in (`kbo_…`, bin/oauth.py) is swapped for the token behind it
first; an ended or unknown one is a 401 without a webhook call.
Tokens come from the login webhook $KB_LOGIN_URL (browser sign-in, admin pages, kb-login).

Off by default: it refuses to start unless KB_SERVER=on and KB_PERMISSION_URL is set. A local install
never opens a port by accident.

Environment:
  KB_SERVER (off)            must be "on" to start
  KB_PERMISSION_URL (none)   permission webhook, see above
  KB_LOGIN_URL (none)        login webhook; KB_HOOK_HEADERS (JSON) extra headers for both
  KB_HTTP_HOST (127.0.0.1)   KB_HTTP_PORT (8790)   put a TLS proxy in front for the network
  KB_AUTH_CACHE_SECONDS (60) KB_AUTH_TIMEOUT (10)   the permission webhook; the login webhook: KB_LOGIN_TIMEOUT (30)
  KB_MAX_GRAPH_JOBS (3)      KB_MAX_DOCS_JOBS (1)   parallel graphify / qmd processes (kb_core)
  KB_HTTP_IDLE_TIMEOUT (60)  a connection that sends nothing for this long closes
  KB_LOGIN_LIMIT (20) KB_LOGIN_LIMIT_ALL (2000) KB_LOGIN_WINDOW (300)   password attempts (admin.Throttle)
  KB_AUTH_MAX_CHECKS (16) KB_AUTH_CHECK_WAIT (2)   permission webhook calls at once, and the wait for a slot
  KB_DOCS_MODE (light|full|bm25), KB_CONTRACT_EDGES (1|0), KB_CONTRACTS (all|own): see kb_core.py / access.py / settings.py
  KB_USAGE_FILE (<data>/logs/usage.json)   tool usage: SQLite rows in usage.sqlite next to it, written per call

`kb-http usage` prints the usage report with user names; the MCP tool `usage` shows the totals and only
the caller's own arguments.
"""
from __future__ import annotations

import hashlib
import hmac
import json
import os
import secrets
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import admin  # noqa: E402
import kb_core  # noqa: E402
import mcp_rpc  # noqa: E402
from usage import Usage  # noqa: E402,F401  (shared by every server; kb_http.Usage stays importable)
import oauth  # noqa: E402
import warm  # noqa: E402

HOST = os.environ.get("KB_HTTP_HOST", "127.0.0.1")
PORT = int(os.environ.get("KB_HTTP_PORT", "8790"))
PERMISSION_URL = os.environ.get("KB_PERMISSION_URL", "")   # access protocol v1, docs/access-protocol.md
CACHE_SECONDS = float(os.environ.get("KB_AUTH_CACHE_SECONDS", "60"))
AUTH_TIMEOUT = float(os.environ.get("KB_AUTH_TIMEOUT", "10"))
MAX_BODY = 1024 * 1024
SUPPORTED_PROTOCOLS = mcp_rpc.SUPPORTED_PROTOCOLS
MAX_CHECKS = int(os.environ.get("KB_AUTH_MAX_CHECKS", "16"))     # permission webhook calls at once
CHECK_WAIT = float(os.environ.get("KB_AUTH_CHECK_WAIT", "2"))    # seconds a check waits for a free slot
MAX_TOKEN = 4096

# kb-http calls its own webhooks (/local/login, /local/permissions) when an access plugin answers them.
# Those calls carry this header with a value only this process knows: the password limit skips them (the
# outer page counted the attempt already), and they pass the address of the person in X-Forwarded-For.
# Any other request of this machine counts like a request from outside.
SELF_HEADER = "X-KB-Self"
SELF_SECRET = secrets.token_urlsafe(32)


# The (host, port) pairs this process listens on: the configured one, and each one make_server bound.
_LISTENING: set[tuple[str, int]] = {(HOST, PORT)}


def _is_me(u: urllib.parse.SplitResult) -> bool:
    """A loopback URL whose port is one this process listens on, through an address that reaches it
    from loopback. Another service on another port of this machine is not this server."""
    if not _trusted_loopback(u.hostname or ""):
        return False
    try:
        port = u.port or (443 if u.scheme == "https" else 80)
    except ValueError:
        return False
    return any(p == port and (h in ("", "0.0.0.0", "::") or _trusted_loopback(h)) for h, p in _LISTENING)


def self_headers(url: str) -> dict:
    """The self-call header for a webhook URL that is this server's own /local/ webhook (loopback, and
    the port this server listens on), else nothing: the value never goes to another system."""
    u = urllib.parse.urlsplit(url or "")
    if u.path in ("/local/login", "/local/permissions") and _is_me(u):
        return {SELF_HEADER: SELF_SECRET}
    return {}


def is_self_url(url: str) -> bool:
    """Is this webhook URL this server's own /local/login or /local/permissions? Through loopback and the
    port this process listens on, or through the public address of this server (the host of
    KB_PUBLIC_URL or KB_PUBLIC_LOGIN_URL, behind nginx with a path prefix such as /kb). kb-http then calls
    its access plugin in-process: no HTTP, no second connection, and the address of the person stays."""
    u = urllib.parse.urlsplit(url or "")
    if not (u.path.endswith("/local/login") or u.path.endswith("/local/permissions")):
        return False
    if u.path in ("/local/login", "/local/permissions") and _is_me(u):
        return True
    host = (u.hostname or "").lower()
    public = {(urllib.parse.urlsplit(os.environ.get(k, "")).hostname or "").lower()
              for k in PUBLIC_KEYS} - {""}
    return bool(host) and host in public


PUBLIC_KEYS = ("KB_PUBLIC_URL", "KB_PUBLIC_LOGIN_URL")


def load_public_urls(env=None) -> None:
    """KB_PUBLIC_URL and KB_PUBLIC_LOGIN_URL from `<data>/smtp.env` into `env` (default: os.environ) when
    the environment has no value. The users add-on reads its mail address from that file; without this
    kb-http would not know that host as its own and would send its /local/ webhook calls over the network."""
    env = os.environ if env is None else env
    try:
        with open(os.path.join(kb_core.KB, "smtp.env"), encoding="utf-8") as f:
            lines = f.read(1 << 16).splitlines()
    except OSError:
        return
    for line in lines:
        key, sep, value = line.strip().partition("=")
        key, value = key.strip(), value.strip().strip('"').strip("'")
        if sep and key in PUBLIC_KEYS and value and not env.get(key):
            env[key] = value


def plugin_login(access, body: dict, ip: str, purpose: str = "agent") -> dict:
    """The login webhook answered by the access plugin in this process. The same contract as an HTTP
    call (kb_login.post): the answer dict, or LoginError with "HTTP <status>: <message>"."""
    try:
        status, answer, *rest = access.login({**body, "ip": ip, "purpose": purpose}, kb_core)
    except Exception as e:  # noqa: BLE001 — a broken plugin is an outage, never an open door
        log(f"access plugin login failed: {type(e).__name__}")
        raise oauth.kb_login.LoginError("HTTP 503: the access plugin is not available") from None
    if int(status) == 200 and isinstance(answer, dict):
        return answer
    msg = (answer.get("message") if isinstance(answer, dict) else None) or "refused"
    retry = (rest[0] if rest and isinstance(rest[0], dict) else {}).get("Retry-After")
    if int(status) == 429 and retry:
        msg = f"{msg} (retry after {retry} s)"
    raise oauth.kb_login.LoginError(f"HTTP {int(status)}: {msg}")


def webhook_login(access, url: str, body: dict, headers: dict, ip: str, purpose: str = "agent") -> dict:
    """One call of the login webhook: in-process when the URL is this server and an access plugin is on,
    else over HTTP with `headers`."""
    if access is not None and is_self_url(url):
        return plugin_login(access, body, ip, purpose)
    return oauth.kb_login.post(url, body, headers=headers)


def _trusted_loopback(host: str) -> bool:
    import ipaddress
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False

# Told to a caller without a valid token: how to get one.
AUTH_HINT = os.environ.get(
    "KB_AUTH_HINT",
    "Sign in through your MCP client (it opens a browser page), or get a token with bin/kb-login "
    "(github.com/xamresor/knowledge-index) and pass it as 'Authorization: Bearer <token>'.")


def login_env(env: dict | None = None, for_oauth: bool = True) -> dict:
    """The login webhook settings (KB_LOGIN_URL, KB_HOOK_HEADERS): the environment first, then the first
    KEY=VALUE file found. Empty dict = no sign-in. `for_oauth`: KB_OAUTH=off empties it (no browser
    sign-in of MCP clients); the admin pages ask with False, so they stay with KB_OAUTH=off."""
    env = dict(os.environ if env is None else env)
    for path in (env.get("KB_LOGIN_ENV", ""), os.path.join(kb_core.KB, "kb-login.env"),
                 os.path.join(kb_core.KB, "deploy", "kb-login.env")):
        if path and os.path.isfile(path):
            oauth.kb_login.load_env_file(path, env)  # the environment keeps priority
            break
    if (for_oauth and env.get("KB_OAUTH", "on").lower() == "off") or not env.get("KB_LOGIN_URL"):
        return {}
    return {k: env[k] for k in ("KB_LOGIN_URL", "KB_HOOK_HEADERS") if env.get(k)}


USAGE_FILE = os.environ.get("KB_USAGE_FILE", os.path.join(kb_core.KB, "logs", "usage.json"))

IDLE_TIMEOUT = float(os.environ.get("KB_HTTP_IDLE_TIMEOUT", "60"))  # a silent connection closes after this
# Who a caller is in usage, the call log and the cursor owner: a stable login id first. The display
# `name` comes last: two people may share one, and a webhook may let a person choose it.
NAME_FIELDS = admin.ADMIN_FIELDS + ("name",)


def _audit(user: str, action: str, detail: str = "") -> None:
    """An audit event in the usage database (admin pages, Audit). Never breaks the request."""
    try:
        if USAGE is not None:
            USAGE.event(user, action, detail)
    except Exception:  # noqa: BLE001
        pass


def log(msg: str) -> None:
    sys.stderr.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    sys.stderr.flush()


# --------------------------------------------------------------------------- auth

class Identity:
    def __init__(self, user: dict, projects: list[str], every: bool = False):
        self.user = user
        self.every = every
        # "*" (every project) is a grant of its own: only it may use the unfiltered graph (kb_core._full).
        self.projects = kb_core.AllProjects(projects) if every else set(projects)

    @property
    def name(self) -> str:
        return next((str(self.user[k]) for k in NAME_FIELDS if self.user.get(k)), "?")


def _no_project(ident: Identity) -> bool:
    """A user the permission webhook gave no project: only an admin may use the admin pages then."""
    return not ident.projects and not ident.every


class AuthError(Exception):
    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status
        self.message = message


class Authenticator:
    """Checks a bearer token with the permission webhook and caches the verdict per token hash."""

    def __init__(self, url: str = "", ttl: float = CACHE_SECONDS,
                 timeout: float = AUTH_TIMEOUT, max_entries: int = 1000,
                 max_checks: int = MAX_CHECKS, check_wait: float = CHECK_WAIT):
        self.url = url or PERMISSION_URL
        # A flood of random tokens misses the cache every time: each would be a webhook call and a thread
        # that waits for it. At most `max_checks` calls run at once; one more waits `check_wait`, then 503.
        self._slots = threading.BoundedSemaphore(max(1, max_checks))
        self.check_wait = check_wait
        self.access_tokens = None  # bin/oauth.py: an access token of the browser sign-in -> the token behind it
        self.ttl = ttl
        self.timeout = timeout
        self.max_entries = max_entries
        # A refusal is kept as (status, message), never as the exception: a raised exception collects a
        # traceback that holds the request handler (its socket and buffers) for as long as the entry lives.
        self._cache: dict[str, tuple[float, Identity | tuple[int, str]]] = {}
        self._lock = threading.Lock()
        self.upstream_calls = 0  # for tests and logs
        # The access plugin of this process (make_server): a permission URL of this server is answered by
        # it in-process, not over HTTP.
        self.access = None
        # forget() bumps it: an answer that was asked before a forget() is not cached after it, so a
        # revoke holds at once and not after KB_AUTH_CACHE_SECONDS.
        self._generation = 0

    def forget(self) -> None:
        """Drop every cached verdict: an admin changed a user, and the change must hold at once."""
        with self._lock:
            self._cache.clear()
            self._generation += 1

    @staticmethod
    def token_from_header(header: str | None) -> str:
        parts = (header or "").strip().split(None, 1)
        if len(parts) != 2 or parts[0].lower() != "bearer" or not parts[1].strip():
            raise AuthError(401, "missing bearer token")
        return parts[1].strip()

    @staticmethod
    def well_formed(token: str) -> bool:
        """A token that can be sent in a header at all: printable ASCII, no space, at most MAX_TOKEN long."""
        return 0 < len(token) <= MAX_TOKEN and all(33 <= ord(c) <= 126 for c in token)

    def check(self, header: str | None, admin_pages: bool = False) -> Identity:
        """An incoming request: an access token of the browser sign-in (`kbo_…`) is swapped for the token
        behind it, then that token is checked with the permission webhook. `admin_pages`: the caller is
        the sign-in of the admin pages, which takes a user without a project too and decides by role."""
        token = self.token_from_header(header)
        if not self.well_formed(token):
            raise AuthError(401, "invalid or expired token")
        if token.startswith(oauth.ACCESS_PREFIX) and self.access_tokens is not None:
            behind = self.access_tokens(token)
            if behind is None:
                raise AuthError(401, "invalid or expired token")
            token = behind
        return self.check_upstream(token, admin_pages)

    def check_upstream(self, token: str, admin_pages: bool = False) -> Identity:
        """A token of the login webhook, checked with the permission webhook as it is. Never swapped: an
        upstream token may start with `kbo_` too (an OAuth refresh checks the token behind the wrapper)."""
        if not self.well_formed(token):
            raise AuthError(401, "invalid or expired token")
        key = hashlib.sha256(token.encode()).hexdigest()
        now = time.monotonic()
        with self._lock:
            hit = self._cache.get(key)
            generation = self._generation
        if hit and hit[0] > now:
            verdict = hit[1]
        else:
            if not self._slots.acquire(timeout=self.check_wait):
                log("auth: too many token checks at once")
                raise AuthError(503, "the server is busy checking tokens: try again in a moment")
            try:
                asked = self._ask(token)
            finally:
                self._slots.release()
            verdict = (asked.status, asked.message) if isinstance(asked, AuthError) else asked
            if not (isinstance(verdict, tuple) and verdict[0] == 503):  # never cache an outage
                with self._lock:
                    if generation == self._generation:   # a forget() came while we asked: keep nothing
                        if len(self._cache) >= self.max_entries:
                            self._cache = {k: v for k, v in self._cache.items() if v[0] > now}
                            if len(self._cache) >= self.max_entries:
                                self._cache.clear()
                        self._cache[key] = (now + self.ttl, verdict)
        if isinstance(verdict, tuple):
            raise AuthError(*verdict)
        # A user with no project gets nothing from MCP; only the admin pages may take it (an admin of the
        # users plugin whose projects are gone must still get in to fix that).
        if _no_project(verdict) and not admin_pages:
            raise AuthError(403, "no KB projects for this user")
        return verdict

    def _ask(self, token: str) -> Identity | AuthError:
        """The permission webhook of access protocol v1: the token and the KB's projects in, the user
        and the allowed subset (or "*") out."""
        self.upstream_calls += 1
        known = sorted(kb_core.PROJECTS)
        if self.access is not None and is_self_url(self.url):
            status, body = self._ask_plugin(token, known)
            return self._verdict(status, body, known)
        try:
            extra = {**oauth.kb_login.hook_headers(), **self_headers(self.url)}
        except oauth.kb_login.LoginError:
            extra = self_headers(self.url)
        req = urllib.request.Request(
            self.url, data=json.dumps({"protocol": 1, "projects": known}).encode(), method="POST",
            headers={"Authorization": f"Bearer {token}", "Accept": "application/json",
                     "Content-Type": "application/json", "User-Agent": "kb-http/1.0", **extra})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as r:
                status, body = r.status, r.read(1024 * 1024)
        except urllib.error.HTTPError as e:
            status, body = e.code, b""
        except Exception as e:  # noqa: BLE001  (URLError, timeout, TLS, reset)
            log(f"auth: permission webhook unreachable: {type(e).__name__}")
            return AuthError(503, "auth service unreachable")
        return self._verdict(status, body, known)

    def _ask_plugin(self, token: str, known: list[str]) -> tuple[int, bytes]:
        """The permission webhook answered by the access plugin of this process: no HTTP call."""
        try:
            status, answer = self.access.permissions(token, known, kb_core)
            return int(status), json.dumps(answer).encode()
        except Exception as e:  # noqa: BLE001 — a broken plugin is an outage, never an open door
            log(f"access plugin failed: {type(e).__name__}")
            return 503, b""

    @staticmethod
    def _verdict(status: int, body: bytes, known: list[str]) -> Identity | AuthError:
        if status == 401:
            return AuthError(401, "invalid or expired token")
        if status >= 500:  # an outage of the webhook, not a refusal: 503, and the cache does not keep it
            log(f"auth: permission webhook answered {status}")
            return AuthError(503, "auth service unavailable")
        if status != 200:
            return AuthError(403, f"access denied (permission webhook answered {status})")
        try:
            data = json.loads(body)
            user = data.get("user") or {}
            projects = data.get("projects")
            every = projects == "*"
            if every:
                projects = known
            if not isinstance(user, dict) or not isinstance(projects, list) \
                    or not all(isinstance(p, str) for p in projects):
                raise ValueError("unexpected shape")
        except (ValueError, AttributeError):
            log("auth: permission webhook answered 200 with an unexpected body")
            return AuthError(503, "auth service gave an unexpected answer")
        projects = [p for p in projects if p in known] if known else projects
        # No project left is kept as an identity: check() refuses it for MCP, the admin pages decide by role.
        return Identity(user, projects, every)


# --------------------------------------------------------------------------- usage

USAGE: Usage | None = None  # set by make_server()

USAGE_TOOL = {"name": "usage", "description": "How the KB is used: calls per tool and per day for "
              "everyone, and your own most frequent arguments. Never shows what other people asked, "
              "and no user names.",
              "inputSchema": {"type": "object", "properties": {}}}


# --------------------------------------------------------------------------- MCP

_warm_lock = threading.Lock()
_warm_at = float("-inf")


def warm_docs(every: float = 600.0) -> None:
    """Preload the qmd model at most once per `every` seconds: each warm-up is a qmd process of
    several hundred MB, so one per client session would add up."""
    global _warm_at
    with _warm_lock:
        if time.monotonic() - _warm_at < every:
            return
        _warm_at = time.monotonic()
    kb_core.warm_qmd()


rpc_result = mcp_rpc.rpc_result
rpc_error = mcp_rpc.rpc_error


def handle_message(msg, ident: Identity) -> dict | None:
    """One JSON-RPC message -> answer (None for a notification). Never raises: bin/mcp_rpc.py, with the
    caller's projects, the tool `usage` and the call log of this server."""
    def call(name: str, args: dict) -> str:
        return kb_core.call_tool(name, args, ident.projects, ident.name)

    def on_call(name: str, args: dict, ok: bool, took: float) -> None:
        log(f"call user={ident.name} tool={name} projects={','.join(sorted(ident.projects))} ok={ok} {took:.1f}s")
        if USAGE:
            USAGE.record(name, ident.name, args, ok, took)

    def usage(_args: dict) -> str:
        return USAGE.report(with_users=False, only_user=ident.name) if USAGE else "(usage counting is off)"

    return mcp_rpc.handle_message(msg, call=call, instructions=lambda: kb_core.instructions(sorted(ident.projects)),
                                  extra_tools=(USAGE_TOOL,), extra_calls={USAGE_TOOL["name"]: usage},
                                  on_call=on_call, on_initialize=warm_docs,
                                  log=lambda m: log(f"{m} user={ident.name}"))


def _trusted_proxy(addr: str) -> bool:
    """Loopback, or an address in KB_TRUSTED_PROXIES (comma-separated addresses or networks, e.g. the
    Docker bridge `172.17.0.0/16` when nginx runs outside the container)."""
    import ipaddress
    try:
        ip = ipaddress.ip_address(addr.removeprefix("::ffff:"))
    except ValueError:
        return False
    if ip.is_loopback:
        return True
    for net in filter(None, (x.strip() for x in os.environ.get("KB_TRUSTED_PROXIES", "").split(","))):
        try:
            if ip in ipaddress.ip_network(net, strict=False):
                return True
        except ValueError:
            continue
    return False


class Handler(BaseHTTPRequestHandler):
    server_version = "kb-http/1.0"
    protocol_version = "HTTP/1.1"
    timeout = IDLE_TIMEOUT  # an idle kept-alive connection (or a slow sender) does not hold a thread forever
    auth: Authenticator  # set on the subclass by make_server()
    admins: set = set()
    access = None  # an access plugin (bin/plugins.py): it answers the two webhooks, and may bring pages
    sessions = admin.Sessions()
    logins = admin.Logins()
    login_limit = admin.login_throttle()
    register_limit = admin.register_throttle()
    authorize_limit = admin.Throttle(int(os.environ.get("KB_OAUTH_AUTHORIZE_LIMIT", "60")), 0, 300)
    oauth: "oauth.Server | None" = None
    hook_env: dict = {}   # KB_LOGIN_URL, KB_HOOK_HEADERS for the admin sign-in: there also with KB_OAUTH=off

    def log_message(self, fmt: str, *args) -> None:  # request line only, never headers
        line = fmt % args
        if "/admin/" in line and "?" in line:  # a page link can carry a one-time value: never log it
            import re
            line = re.sub(r"(/admin/[^ ?\"]*)\?[^ \"]*", r"\1?…", line)
        log(f"{self.address_string()} {line}")

    def _send(self, status: int, body: dict | list | None, headers: dict | None = None) -> None:
        data = b"" if body is None else json.dumps(body).encode()
        self.send_response(status)
        if body is not None:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        if status >= 400:
            # An error can come before the body is read; the rest of the body must not be parsed
            # as the next request on a kept-alive connection.
            self.send_header("Connection", "close")
            self.close_connection = True
        else:
            self._close_if_unread()
        self.end_headers()
        if data:
            self.wfile.write(data)

    def _close_if_unread(self) -> None:
        """An answer to a POST whose body nobody read (a redirect to the sign-in, a refusal) ends the
        connection: the unread body must not be parsed as the next request."""
        if self.command == "POST" and not getattr(self, "_body_read", False):
            self.send_header("Connection", "close")
            self.close_connection = True

    def _client_ip(self) -> str:
        """The address of the client. Behind a trusted proxy (this machine, or KB_TRUSTED_PROXIES) it is
        the last X-Forwarded-For entry: the one the proxy added. The entries before it come from the
        client and prove nothing."""
        peer = self.client_address[0]
        fwd = self.headers.get("X-Forwarded-For")
        if fwd and _trusted_proxy(peer):
            return fwd.split(",")[-1].strip() or peer
        return peer

    def _self_call(self) -> bool:
        """kb-http asking itself (its own webhooks): loopback and the secret header of this process."""
        given = self.headers.get(SELF_HEADER) or ""
        return _trusted_loopback(self.client_address[0].removeprefix("::ffff:")) and \
            hmac.compare_digest(given.encode(), SELF_SECRET.encode())

    def _limited(self, limit: "admin.Throttle", page: bool) -> bool:
        """Count one attempt at a password page. True when the limit is reached and the 429 went out.
        kb-http asking itself is not counted: the outer page has counted the attempt already. Any other
        request of this machine counts, under its address."""
        if self._self_call():
            return False
        wait = limit.hit(self._client_ip())
        if wait is None:
            return False
        log(f"limit: too many attempts from {self._client_ip()} at {self.path.split('?')[0]}")
        headers = {"Retry-After": str(wait)}
        if page:
            self._send_page(429, admin.page("KB", "<main class=login><section>Too many attempts. Try again in a "
                                                  "few minutes.</section></main>"), headers)
        else:
            self._send(429, {"error": "too_many_requests", "message": "too many attempts: try again later"},
                       headers)
        return True

    def _not_allowed(self) -> None:
        if self.path.split("?")[0] != "/mcp":
            self._send(404, {"error": "not found"})
        else:
            self._send(405, {"error": "method not allowed"}, {"Allow": "POST"})

    do_DELETE = do_PUT = do_PATCH = _not_allowed

    # ------------------------------------------------------------------ OAuth (bin/oauth.py)
    def _base(self) -> str:
        """This server's public URL as the client sees it (nginx passes the prefix it strips)."""
        proto = self.headers.get("X-Forwarded-Proto") or "http"
        host = self.headers.get("X-Forwarded-Host") or self.headers.get("Host") or f"{HOST}:{PORT}"
        prefix = (self.headers.get("X-Forwarded-Prefix") or "").rstrip("/")
        return f"{proto}://{host}{prefix}"

    def _send_page(self, status: int, body: bytes, headers: dict | None = None) -> None:
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", f"default-src 'none'; style-src 'unsafe-inline'; "
                                                    f"script-src {admin.script_hash()}; "
                                                    "form-action 'self' http://localhost:* http://127.0.0.1:* http://[::1]:*; "
                                                    "frame-ancestors 'none'")
        # form-action also governs where a submitted form may be redirected: with 'self' alone the
        # browser blocked the final 302 to the MCP client's loopback callback after a good sign-in.
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self._close_if_unread()
        self.end_headers()
        self.wfile.write(body)

    def _redirect(self, url: str) -> None:
        self.send_response(302)
        self.send_header("Location", url)
        self.send_header("Content-Length", "0")
        self.send_header("Cache-Control", "no-store")
        self._close_if_unread()
        self.end_headers()

    def _body(self) -> bytes | None:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length < 0 or length > MAX_BODY:
            return None
        data = self.rfile.read(length)
        self._body_read = True
        return data

    def _form(self) -> dict | None:
        raw = self._body()
        if raw is None:
            return None
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip()
        if ctype == "application/json":
            try:
                data = json.loads(raw or b"{}")
            except ValueError:
                return None
            return data if isinstance(data, dict) else None
        return {k: v[0] for k, v in urllib.parse.parse_qs(raw.decode("utf-8", "replace")).items()}

    def _oauth_error(self, e: "oauth.OAuthError") -> None:
        self._send(e.status, {"error": e.error, "error_description": e.description})

    # ------------------------------------------------------------------ admin (bin/admin.py)
    def _cookie(self) -> str | None:
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == admin.COOKIE:
                return v
        return None

    def _set_cookie(self, sid: str, max_age: int) -> dict:
        secure = "; Secure" if (self.headers.get("X-Forwarded-Proto") or "") == "https" else ""
        prefix = (self.headers.get("X-Forwarded-Prefix") or "").rstrip("/")
        return {"Set-Cookie": f"{admin.COOKIE}={sid}; Path={prefix}/admin; HttpOnly; "
                              f"SameSite=Strict; Max-Age={max_age}{secure}"}

    def _admin(self, method: str, path: str) -> None:
        """The admin pages (part of the core): there when the server has admins (KB_ADMINS, admins.txt or
        an access plugin with roles) and a login webhook for the sign-in."""
        import addons
        with_roles = callable(getattr(self.access, "role", None))  # the access plugin names its own admins
        if not (self.admins or with_roles) or not self.hook_env:
            self._send(404, {"error": "not found"})
            return
        base = self._base()
        sid = self._cookie()
        session = self.sessions.get(sid)
        if path == "/admin/login":
            if method == "GET":
                self._send_page(200, admin.login_page(base))
                return
            if not self._limited(self.login_limit, page=True):
                self._admin_login(base)
            return
        if path[len("/admin"):] in (getattr(self.access, "PUBLIC", None) or []) \
                and callable(getattr(self.access, "public_page", None)):
            if method != "POST" or not self._limited(self.login_limit, page=True):
                self._plugin_public(base, method, path)
            return
        if session is not None:
            session = self._recheck(sid, session)
            if session is False:
                return  # the permission webhook is down: the 503 page went out
        if session is None:
            self._redirect(f"{base}/admin/login")
            return
        # A person whom the access plugin lets in but who is no admin: the tabs the plugin opens to
        # every member and the how-to, nothing else.
        tab = self._plugin_tab(path) if callable(getattr(self.access, "page", None)) else None
        member = not session.get("admin", True)
        if member and not (path in ("/admin/logout", "/admin/howto") or (tab is not None and tab[2] == "member")):
            home = self._member_home()
            if method == "GET" and path == "/admin" and home:
                self._redirect(f"{base}/admin{home}")
                return
            self._send_page(403, admin.page("KB admin", "<main><section>This page is for the admins of this "
                                            "server.</section></main>", base, "", session["csrf"], member=True))
            return
        if method == "POST":
            form = self._form() or {}
            if not secrets_compare(str(form.get("csrf", "")), session["csrf"]):
                self._send_page(403, admin.page("KB admin", "<main><section>Form expired: reload the page.</section></main>"))
                return
            if path == "/admin/logout":
                _audit(admin_name(session["user"]), "admin sign-out")
                self.sessions.drop(sid)
                self.send_response(302)
                for k, v in {**self._set_cookie("", 0), "Location": f"{base}/admin/login"}.items():
                    self.send_header(k, v)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            if path == "/admin/rebuild":
                log(f"admin: rebuild by {admin_name(session['user'])}")
                _audit(admin_name(session["user"]), "rebuild")
                self._send_page(200, admin.status_page(base, session["csrf"], admin.status(self.oauth),
                                                       session["user"], admin.rebuild()))
                return
            if tab is not None:
                self._plugin_page(base, session, sid, "POST", path, form, tab)
                return
            if path in ("/admin/settings/addon", "/admin/settings/set"):
                who = admin_name(session["user"])
                status, note, done = admin.change_setting(form)
                if done:
                    action = "setting" if path.endswith("/set") else \
                        f"add-on {'on' if str(form.get('on')) == '1' else 'off'}"
                    log(f"admin: {action} {done} by {who}")
                    _audit(who, action, done)
                self._send_page(status, admin.settings_page(base, session["csrf"], note, bad=status != 200))
                return
            if path == "/admin/clients/revoke":
                cid = str(form.get("client_id", ""))
                note = "Revoked." if self.oauth is not None and self.oauth.revoke(cid) else "No such client."
                log(f"admin: revoke {cid[:12]} by {admin_name(session['user'])}")
                _audit(admin_name(session["user"]), "revoke client", f"{cid[:12]} {note}")
                self._send_page(200, admin.clients_page(base, session["csrf"], self._clients(), note))
                return
            if path == "/admin/questions/label" and addons.on("questions"):
                tool, arg = str(form.get("tool", "")), str(form.get("arg", ""))
                project, how = str(form.get("project", "")), str(form.get("how", ""))
                who = admin_name(session["user"])
                if how == "clear":
                    USAGE.unlabel(tool, arg, project)
                    note = "Label cleared."
                elif USAGE.label(tool, arg, project, expected=str(form.get("expected", "")),
                                 no_answer=how == "no_answer", skip=how == "skip", by=who):
                    note = "Saved."
                else:
                    note = "Not saved: give the path or symbol, or choose \"No answer\" or \"Skip\"."
                _audit(who, "label question", f"{tool} {how} {arg[:60]}")
                self._send_page(200, admin.questions_page(base, session["csrf"], USAGE, note))
                return
            self._send(404, {"error": "not found"})
            return
        if path == "/admin":
            self._send_page(200, admin.status_page(base, session["csrf"], admin.status(self.oauth), session["user"]))
        elif path == "/admin/usage":
            q = {k: v[0] for k, v in urllib.parse.parse_qs(self.path.partition("?")[2]).items()}
            self._send_page(200, admin.usage_page(base, session["csrf"], USAGE, q))
        elif path == "/admin/audit" and addons.on("audit"):
            q = {k: v[0] for k, v in urllib.parse.parse_qs(self.path.partition("?")[2]).items()}
            self._send_page(200, admin.audit_page(base, session["csrf"], USAGE, q))
        elif path == "/admin/questions" and addons.on("questions"):
            self._send_page(200, admin.questions_page(base, session["csrf"], USAGE))
        elif path == "/admin/questions.json" and addons.on("questions"):
            self._send(200, {"questions": USAGE.golden() if USAGE else []})
        elif path == "/admin/clients":
            self._send_page(200, admin.clients_page(base, session["csrf"], self._clients()))
        elif path == "/admin/index":
            self._send_page(200, admin.index_page(base, session["csrf"], USAGE))
        elif path == "/admin/settings":
            self._send_page(200, admin.settings_page(base, session["csrf"]))
        elif tab is not None:
            self._plugin_page(base, session, sid, "GET", path, {}, tab)
        elif path == "/admin/howto":
            self._send_page(200, admin.howto_page(base, session["csrf"], os.environ.get("KB_PUBLIC_LOGIN_URL", ""),
                                                  member))
        else:
            self._send(404, {"error": "not found"})

    def _clients(self) -> dict:
        """The registered OAuth clients, copied under the lock of bin/oauth.py (none with KB_OAUTH=off)."""
        return self.oauth.clients_snapshot() if self.oauth is not None else {}

    def _recheck(self, sid: str | None, session: dict):
        """Check the token behind a session again on every request (the verdict is cached for
        KB_AUTH_CACHE_SECONDS): a new password, a removed token or a lost admin right ends the session
        or its admin pages at once, not after 8 hours. -> the session, None (ended) or False (503 sent)."""
        try:
            ident = self.auth.check(f"Bearer {session['token']}", admin_pages=True)
        except AuthError as e:
            if e.status == 503:
                self._send_page(503, admin.page("KB admin", "<main><section>The sign-in service is not "
                                                            "available. Try again in a minute.</section></main>"))
                return False
            self.sessions.drop(sid)
            return None
        role = self._role(session["token"])
        is_admin = admin.is_admin(ident.user, self.admins) or role == "admin"
        if not is_admin and (_no_project(ident) or not (role == "member" and self._member_home())):
            self.sessions.drop(sid)
            return None
        session["admin"] = is_admin
        return session

    def _role(self, token: str) -> str | None:
        """The role the access plugin gives a token ("admin", "member"), or None."""
        if not callable(getattr(self.access, "role", None)):
            return None
        try:
            return self.access.role(token, kb_core)
        except Exception as e:  # noqa: BLE001 — a broken plugin gives nobody a role
            log(f"access plugin role failed: {type(e).__name__}")
            return None

    def _plugin_tab(self, path: str) -> tuple[str, str, str] | None:
        """The tab of the access plugin that owns an /admin path: (label, path under /admin, who)."""
        for label, tab, who in getattr(self.access, "TABS", None) or []:
            if path == f"/admin{tab}" or path.startswith(f"/admin{tab}/"):
                return label, tab, who
        return None

    def _plugin_public(self, base: str, method: str, path: str) -> None:
        """A page of the access plugin that needs no session ("forgot password"). The plugin owns its
        safety: there is no session and so no csrf value."""
        form = (self._form() or {}) if method == "POST" else {}
        query = {k: v[0] for k, v in urllib.parse.parse_qs(self.path.partition("?")[2]).items()}
        req = {"method": method, "path": path[len("/admin"):], "form": form, "query": query, "base": base,
               "now": time.time(), "ip": self._client_ip(),
               "audit": lambda action, detail="": _audit("?", action, detail),
               "forget": self.auth.forget, "drop_sessions": self.sessions.drop_user}
        try:
            status, title, body = self.access.public_page(req, kb_core)
        except Exception as e:  # noqa: BLE001 — a broken plugin page never takes the server down
            log(f"access plugin public page failed: {type(e).__name__}")
            status, title, body = 503, "KB", "<main class=login><section>This page is not available.</section></main>"
        self._send_page(int(status), admin.page(title, body))

    def _member_home(self) -> str | None:
        """The first tab of the access plugin that a person who is no admin may open."""
        return next((tab for _, tab, who in getattr(self.access, "TABS", None) or [] if who == "member"), None)

    def _plugin_page(self, base: str, session: dict, sid: str | None, method: str, path: str, form: dict,
                     tab: tuple[str, str, str]) -> None:
        """A page of the access plugin (bin/plugins.py). The core has checked the session, the csrf value
        of a form and who may open the tab; the plugin answers with a title and a body."""
        user = admin_name(session["user"]).lower()

        def audit(action: str, detail: str = "") -> None:
            log(f"{getattr(self.access, 'NAME', 'plugin')}: {action} {detail} by {user}".replace("  ", " "))
            _audit(user, action, detail)

        req = {"method": method, "path": path[len("/admin"):], "form": form, "base": base, "csrf": session["csrf"],
               "user": user, "admin": bool(session.get("admin", True)), "now": time.time(),
               "forget": self.auth.forget, "drop_sessions": self.sessions.drop_user, "audit": audit}
        try:
            out = self.access.page(req, kb_core)
        except Exception as e:  # noqa: BLE001 — a broken plugin page never takes the server down
            log(f"access plugin page failed: {type(e).__name__}")
            out = (503, "KB admin", "<main><section>This page is not available.</section></main>")
        if out[0] == "redirect":
            self.sessions.drop(sid)
            self._redirect(f"{base}/admin/login")
            return
        status, title, body = out
        self._send_page(int(status), admin.page(title, body, base, tab[0], session["csrf"], member=not req["admin"]))

    def _local_hook(self, path: str) -> None:
        """The two webhooks of access protocol v1, answered inside this server by the access plugin
        (bin/plugins.py)."""
        form = self._form()
        if form is None:
            self._send(400, {"message": "unreadable body"})
            return
        try:
            if path == "/local/login":
                if self._limited(self.login_limit, page=False):
                    return
                form["ip"] = self._client_ip()   # the plugin counts wrong passwords per name and address
                status, body, *rest = self.access.login(form, kb_core)
                self._send(int(status), body, rest[0] if rest else None)
                return
            # The permission webhook is for this server only (in-process, or its own call with the self
            # header): open to the network it is an unlimited, uncached token check, a proxy to the
            # system behind the plugin. /local/login stays public for kb-login.
            if not self._self_call():
                self._send(403, {"message": "the permission webhook answers this server only"})
                return
            try:
                token = Authenticator.token_from_header(self.headers.get("Authorization"))
            except AuthError:
                self._send(401, {"message": "missing bearer token"})
                return
            asked = form.get("projects")
            status, body = self.access.permissions(token, asked if isinstance(asked, list) else [], kb_core)
            self._send(int(status), body)
        except Exception as e:  # noqa: BLE001 — a broken plugin is an outage, never an open door
            log(f"access plugin failed: {type(e).__name__}")
            self._send(503, {"message": "the access plugin is not available"})

    def _admin_login(self, base: str) -> None:
        form = self._form() or {}
        env = self.hook_env
        url = env["KB_LOGIN_URL"]
        h = {**oauth.kb_login.hook_headers(env), **self_headers(url)}
        if SELF_HEADER in h:
            h["X-Forwarded-For"] = self._client_ip()   # our own webhook counts the person's address
        try:
            if form.get("lid"):
                challenge = self.logins.take(str(form["lid"]))
                if not challenge:
                    self._send_page(200, admin.login_page(base, error="The sign-in took too long: start again."))
                    return
                data = webhook_login(self.access, url, {"challenge": challenge,
                                                        "code": str(form.get("code", "")).strip()},
                                     h, self._client_ip(), "page")
            else:
                data = webhook_login(self.access, url, {"username": str(form.get("username", "")),
                                                        "password": str(form.get("password", ""))},
                                     h, self._client_ip(), "page")
                challenge = oauth.kb_login.challenge_of(data)
                if challenge:
                    self._send_page(200, admin.login_page(base, "code", self.logins.put(challenge)))
                    return
            token = data.get("token")
            if not isinstance(token, str) or not token:
                raise oauth.kb_login.LoginError("the login webhook answered without a token")
            ident = self.auth.check(f"Bearer {token}", admin_pages=True)
            role = self._role(token)
            is_admin = admin.is_admin(ident.user, self.admins) or role == "admin"
            if not is_admin and _no_project(ident):   # only an admin gets in without a project
                raise AuthError(403, "no KB projects for this user")
        except (oauth.kb_login.LoginError, AuthError) as e:
            log(f"admin: sign-in refused: {str(e)[:120]}")
            _audit(str(form.get("username", "")) or "?", "admin sign-in refused", str(e)[:200])
            self._send_page(200, admin.login_page(base, error=str(e)))
            return
        member_home = self._member_home() if role == "member" else None
        if not is_admin and not member_home:
            log(f"admin: {admin_name(ident.user)} is not an admin")
            _audit(admin_name(ident.user), "admin sign-in refused", "not an admin")
            self._send_page(403, admin.login_page(base, error="This account is not a KB admin."))
            return
        sid = self.sessions.create(ident.user, token, admin=is_admin)
        log(f"admin: signed in {admin_name(ident.user)}{'' if is_admin else ' (member pages only)'}")
        _audit(admin_name(ident.user), "admin sign-in" if is_admin else "sign-in")
        self.send_response(302)
        home = f"{base}/admin" if is_admin else f"{base}/admin{member_home}"
        for k, v in {**self._set_cookie(sid, admin.SESSION_TTL), "Location": home}.items():
            self.send_header(k, v)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _metrics(self) -> None:
        """GET /metrics (bin/metrics.py), only when KB_METRICS=on; 404 otherwise."""
        import addons
        if not (addons.on("metrics") or os.environ.get("KB_METRICS", "off").lower() == "on"):
            self._send(404, {"error": "not found"})
            return
        import metrics
        if not metrics.allowed(self.client_address[0], self.headers):
            self._send(401, {"error": "metrics need KB_METRICS_TOKEN"}, {"WWW-Authenticate": 'Basic realm="kb"'})
            return
        data = metrics.render(USAGE, self.oauth).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:  # noqa: N802
        path, _, qs = self.path.partition("?")
        if path == "/metrics":
            self._metrics()
            return
        if path == "/admin" or path.startswith("/admin/"):
            self._admin("GET", path.rstrip("/") or "/admin")
            return
        srv = self.oauth
        if srv is None:
            self._not_allowed()
            return
        base = self._base()
        if path in ("/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/mcp"):
            self._send(200, srv.resource_metadata(base))
        elif path.startswith("/.well-known/oauth-authorization-server") or \
                path.startswith("/.well-known/openid-configuration"):
            self._send(200, srv.server_metadata(base))
        elif path == "/authorize":
            if self._limited(self.authorize_limit, page=True):   # per address only: no lockout of all
                return
            q = {k: v[0] for k, v in urllib.parse.parse_qs(qs).items()}
            try:
                txn = srv.start(q, self._client_ip())
            except oauth.OAuthError as e:
                self._send_page(e.status, oauth.page(f"{base}/authorize", "", "password", e.description))
                return
            self._send_page(200, oauth.page(f"{base}/authorize", txn, "password"))
        else:
            self._not_allowed()

    def _oauth_post(self, path: str) -> None:
        srv, base = self.oauth, self._base()
        form = self._form()
        if form is None:
            self._send(400, {"error": "invalid_request", "error_description": "unreadable body"})
            return
        if path == "/register":
            if self._limited(self.register_limit, page=False):
                return
            try:
                self._send(201, srv.register(form))
            except oauth.OAuthError as e:
                self._oauth_error(e)
        elif path == "/token":
            try:
                self._send(200, srv.token(form))
            except oauth.OAuthError as e:
                self._oauth_error(e)
        elif path == "/authorize":
            txn, step = str(form.get("txn", "")), form.get("step")
            action = f"{base}/authorize"
            if self._limited(self.login_limit, page=True):
                return
            try:
                if step == "code":
                    self._redirect(srv.code_step(txn, str(form.get("code", ""))))
                    return
                state, url = srv.password_step(txn, str(form.get("username", "")),
                                               str(form.get("password", "")))
                if state == "code":
                    self._send_page(200, oauth.page(action, txn, "code"))
                else:
                    self._redirect(url)
            except oauth.OAuthError as e:
                self._send_page(400, oauth.page(action, "", "password", e.description))
            except oauth.kb_login.LoginError as e:
                log(f"oauth: sign-in refused: {str(e)[:120]}")
                self._send_page(200, oauth.page(action, txn, step or "password", str(e)))
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self) -> None:  # noqa: N802
        self._body_read = False  # one handler serves every request of a kept-alive connection
        path = self.path.split("?")[0]
        if path == "/admin" or path.startswith("/admin/"):
            self._admin("POST", path.rstrip("/"))
            return
        if self.oauth is not None and path in ("/register", "/token", "/authorize"):
            self._oauth_post(path)
            return
        if self.access is not None and path in ("/local/login", "/local/permissions"):
            self._local_hook(path)
            return
        if path != "/mcp":
            self._send(404, {"error": "not found"})
            return
        try:
            ident = self.auth.check(self.headers.get("Authorization"))
        except AuthError as e:
            challenge = 'Bearer realm="kb"'
            if self.oauth is not None:
                challenge += f', resource_metadata="{self._base()}/.well-known/oauth-protected-resource"'
            extra = {"WWW-Authenticate": challenge} if e.status == 401 else {}
            body = {"error": e.message}
            if e.status == 401 and AUTH_HINT:
                body["hint"] = AUTH_HINT
            self._send(e.status, body, extra)
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > MAX_BODY:
            self._send(413, {"error": "body too large"})
            return
        raw = self.rfile.read(length)
        self._body_read = True
        try:
            payload = json.loads(raw or b"null")
        except (ValueError, UnicodeDecodeError):
            self._send(400, rpc_error(None, -32700, "parse error"))
            return
        status, body = mcp_rpc.handle_payload(payload, lambda m: handle_message(m, ident))
        self._send(status, body)


def secrets_compare(a: str, b: str) -> bool:
    import hmac
    return hmac.compare_digest(a.encode(), b.encode())


def admin_name(user: dict) -> str:
    return next((str(user[k]) for k in admin.ID_FIELDS if user.get(k)), "?")


class _Server(ThreadingHTTPServer):
    # The listen backlog: the default of 5 drops connections when a team's agents start at once.
    request_queue_size = 128


def make_server(host: str = HOST, port: int = PORT, auth: Authenticator | None = None,
                usage: Usage | None = None, oauth_env: dict | None = None,
                admins: set | None = None, access=None) -> ThreadingHTTPServer:
    global USAGE
    USAGE = usage
    admin.set_badge_source(lambda: USAGE.unlabelled() if USAGE is not None and hasattr(USAGE, "unlabelled") else 0)
    auth = auth or Authenticator()
    env = login_env() if oauth_env is None else oauth_env
    hook_env = login_env(for_oauth=False) if oauth_env is None else oauth_env

    def check(token: str) -> None:
        auth.check_upstream(token)   # the token behind a wrapper: never resolved as a wrapper again

    srv_oauth = oauth.Server(env, check, os.path.join(kb_core.KB, "logs", "oauth-clients.json")) \
        if env else None
    if srv_oauth is not None:
        srv_oauth.on_event = _audit
        srv_oauth.headers = self_headers(env.get("KB_LOGIN_URL", ""))
        auth.access_tokens = srv_oauth.resolve
    if access is None:  # False: no access plugin, whatever is installed
        import addons
        import plugins
        access = plugins.access(addons.enabled())
    access = access or None
    admin.set_access(access)  # the pages show this plugin until the next start
    auth.access = access      # a permission URL of this server: the plugin answers in-process
    if srv_oauth is not None:
        srv_oauth.login_post = lambda url, body, headers, ip: webhook_login(access, url, body, headers, ip)
    sessions = admin.Sessions()
    if callable(getattr(access, "logout", None)):
        # A session that ends (sign-out, 8 hours, an admin change) ends its sign-in token in the plugin.
        def ended(token: str) -> None:
            access.logout(token, kb_core)
            auth.forget()
        sessions.on_end = ended
        if srv_oauth is not None:
            # A browser sign-in that never finished, a revoked client, an ended refresh token: its sign-in
            # token ends too, so it does not push out a token the person still uses. Only when the login
            # webhook is this server: a token of another system is not the plugin's.
            def dropped(token: str) -> None:
                if is_self_url(env.get("KB_LOGIN_URL", "")):
                    ended(token)
            srv_oauth.on_drop = dropped
    handler = type("KbHandler", (Handler,), {"auth": auth, "oauth": srv_oauth, "hook_env": hook_env,
                                              "access": access,
                                              "admins": admin.admins() if admins is None else admins,
                                              "sessions": sessions, "logins": admin.Logins(),
                                              "login_limit": admin.login_throttle(),
                                              "register_limit": admin.register_throttle()})
    srv = _Server((host, port), handler)
    srv.daemon_threads = True
    _LISTENING.add((host, srv.server_address[1]))
    return srv


def refuse_reason(env: dict | None = None, access=None) -> str | None:
    """Why the server must not start, or None. Off unless explicitly switched on and configured. `access`
    is the access plugin that is on (None: none is)."""
    env = os.environ if env is None else env
    if env.get("KB_SERVER", "off").lower() != "on":
        return ("kb-http is off. It is a shared, network-facing server: set KB_SERVER=on and "
                "KB_PERMISSION_URL=<permission webhook> to run it (docs/access-protocol.md).")
    url = env.get("KB_PERMISSION_URL", "")
    if not url:
        return ("kb-http: no way to check who is asking. Set KB_PERMISSION_URL to your permission webhook, or "
                "switch on an access plugin on this server: `kb addon list` shows the installed ones, "
                "`kb addon on users` switches the KB's own users back on (`kb addon install contrib/users` "
                "installs it).")
    if access is None and urllib.parse.urlsplit(url).path == "/local/permissions" and self_headers(url):
        return (f"kb-http: KB_PERMISSION_URL ({url}) is this server's own webhook, but no access plugin is on: "
                "every token would get 403. Switch it on: `kb addon on users` (or the plugin you use; "
                "`kb addon list` shows them), then start again.")
    if access is not None and url.rstrip("/").endswith("/local/permissions") and not is_self_url(url):
        # The call would go out over the network, and /local/permissions refuses every call that is not
        # this server: every token would get 403.
        return (f"kb-http: KB_PERMISSION_URL ({url}) looks like this server's own webhook, but its host is "
                f"neither loopback on port {PORT} nor the host of KB_PUBLIC_URL / KB_PUBLIC_LOGIN_URL (the "
                "environment or <data>/smtp.env): every token would get 403. Point it at "
                f"http://127.0.0.1:{PORT}/local/permissions, or set KB_PUBLIC_URL.")
    return None


def main() -> int:
    if sys.argv[1:] == ["usage"]:
        print(Usage(USAGE_FILE).report(with_users=True))
        return 0
    import addons
    import plugins
    on = sorted(n for n in addons.enabled() if plugins.is_access(n))
    if len(on) > 1:
        log(f"kb-http: {len(on)} access plugins are on ({', '.join(on)}); {on[0]} answers the sign-in, the others "
            f"do nothing. Switch the others off: kb addon off <name>.")
    access = plugins.access(addons.enabled())
    load_public_urls()
    if access is not None:
        # An access plugin: both webhooks are this server, unless the unit says otherwise.
        global PERMISSION_URL
        me = f"http://{'127.0.0.1' if HOST in ('', '0.0.0.0', '::') else HOST}:{PORT}"
        os.environ.setdefault("KB_PERMISSION_URL", f"{me}/local/permissions")
        os.environ.setdefault("KB_LOGIN_URL", f"{me}/local/login")
        PERMISSION_URL = os.environ["KB_PERMISSION_URL"]
    reason = refuse_reason(access=access)
    if reason:
        print(reason, file=sys.stderr)
        return 2
    if access is not None:
        for key in ("KB_LOGIN_URL",):   # KB_PERMISSION_URL of this kind stops the start (refuse_reason)
            url = os.environ.get(key, "")
            if url.rstrip("/").endswith(("/local/permissions", "/local/login")) and not is_self_url(url):
                log(f"kb-http: warning: {key} ({url}) looks like this server, but its host is neither loopback "
                    f"on port {PORT} nor the host of KB_PUBLIC_URL: the access plugin is not called in-process, "
                    "the call goes out over the network (and /local/permissions refuses it). Point it at "
                    f"http://127.0.0.1:{PORT}/local/... or set KB_PUBLIC_URL.")
    warm.enable()  # long-lived graphify and qmd: no cold start per call (bin/warm.py)
    kb_core.warm_qmd()
    usage = Usage(USAGE_FILE)
    srv = make_server(usage=usage, access=access or False)
    log(f"kb-http listening on {HOST}:{PORT}, permissions={PERMISSION_URL}, docs_mode={kb_core.DOCS_MODE}, "
        f"projects={','.join(kb_core.PROJECTS)}")
    warm_docs()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        usage.save()
    return 0


if __name__ == "__main__":
    sys.exit(main())
