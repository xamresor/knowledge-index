#!/usr/bin/env python3
"""Shared MCP server over HTTP — so **a team** can query one index. Off by default.

Why it exists
-------------
`kb-mcp` serves one person's agent over stdio; `kb-api` serves scripts on loopback. A team wants one
build on one server, reached by every developer's agent, where each developer sees only the projects
they are allowed to see. That needs a network transport *and* identity, and identity is something
this tool must not invent: it asks an endpoint you already run.

Transport: MCP "streamable HTTP", JSON answers only. POST /mcp with one JSON-RPC message or a batch.
Methods: initialize, notifications/initialized, tools/list, tools/call, ping. GET /mcp -> 405 (no SSE).
The tools are the core's (`kb_core.TOOLS`) plus `usage`; every call goes through `kb_core.call_tool`
with the caller's project set, so the access filter lives in one place (bin/access.py).

Auth: access protocol v1 (docs/access-protocol.md). Every request carries `Authorization: Bearer
<token>`. The server POSTs to $KB_PERMISSION_URL with that token and {"protocol": 1, "projects": [...]}
(the projects of kb.projects.toml) and expects 200 with
    {"user": {"name"|"uname"|"username"|"id"|"uid": ...}, "projects": [subset] | "*"}
Mapping:
    no / malformed Authorization header  -> 401 + WWW-Authenticate: Bearer
    webhook 200                          -> allowed, projects = answer.projects ("*" = all)
    webhook 401                          -> 401
    webhook 403/404/other status         -> 403
    webhook unreachable / bad body       -> 503 (never cached)
    empty project list                   -> 403
The verdict is cached KB_AUTH_CACHE_SECONDS per SHA-256 of the token; the token is never logged.
Tokens come from the login webhook $KB_LOGIN_URL (browser sign-in, admin pages, kb-login).

Off by default: it refuses to start unless KB_SERVER=on and KB_PERMISSION_URL is set. A local install
never opens a port by accident.

Environment:
  KB_SERVER (off)            must be "on" to start
  KB_PERMISSION_URL (none)   permission webhook, see above
  KB_LOGIN_URL (none)        login webhook; KB_HOOK_HEADERS (JSON) extra headers for both
  KB_HTTP_HOST (127.0.0.1)   KB_HTTP_PORT (8790)   put a TLS proxy in front for the network
  KB_AUTH_CACHE_SECONDS (60) KB_AUTH_TIMEOUT (10)
  KB_MAX_GRAPH_JOBS (3)      KB_MAX_DOCS_JOBS (1)   parallel graphify / qmd processes
  KB_DOCS_MODE (light|full|bm25), KB_CONTRACT_EDGES (1|0): see kb_core.py / access.py
  KB_USAGE_FILE (<data>/logs/usage.json)   tool usage counters, saved every 30 s

`kb-http usage` prints the usage report with user names; the MCP tool `usage` shows the totals and only
the caller's own arguments.
"""
from __future__ import annotations

import hashlib
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import admin  # noqa: E402
import kb_core  # noqa: E402
from usage import Usage  # noqa: E402,F401  (shared by every server; kb_http.Usage stays importable)
import oauth  # noqa: E402
import warm  # noqa: E402

HOST = os.environ.get("KB_HTTP_HOST", "127.0.0.1")
PORT = int(os.environ.get("KB_HTTP_PORT", "8790"))
PERMISSION_URL = os.environ.get("KB_PERMISSION_URL", "")   # access protocol v1, docs/access-protocol.md
CACHE_SECONDS = float(os.environ.get("KB_AUTH_CACHE_SECONDS", "60"))
AUTH_TIMEOUT = float(os.environ.get("KB_AUTH_TIMEOUT", "10"))
MAX_BODY = 1024 * 1024
SUPPORTED_PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")

# Told to a caller without a valid token: how to get one.
AUTH_HINT = os.environ.get(
    "KB_AUTH_HINT",
    "Sign in through your MCP client (it opens a browser page), or get a token with bin/kb-login "
    "(github.com/xamresor/knowledge-index) and pass it as 'Authorization: Bearer <token>'.")


def login_env(env: dict | None = None) -> dict:
    """The login webhook settings for the browser sign-in (KB_LOGIN_URL, KB_HOOK_HEADERS): the
    environment first, then the first KEY=VALUE file found. Empty dict = no sign-in page."""
    env = dict(os.environ if env is None else env)
    for path in (env.get("KB_LOGIN_ENV", ""), os.path.join(kb_core.KB, "kb-login.env"),
                 os.path.join(kb_core.KB, "deploy", "kb-login.env")):
        if path and os.path.isfile(path):
            oauth.kb_login.load_env_file(path, env)  # the environment keeps priority
            break
    if env.get("KB_OAUTH", "on").lower() == "off" or not env.get("KB_LOGIN_URL"):
        return {}
    return {k: env[k] for k in ("KB_LOGIN_URL", "KB_HOOK_HEADERS") if env.get(k)}


USAGE_FILE = os.environ.get("KB_USAGE_FILE", os.path.join(kb_core.KB, "logs", "usage.json"))

GRAPH_JOBS = threading.BoundedSemaphore(int(os.environ.get("KB_MAX_GRAPH_JOBS", "3")))
DOCS_JOBS = threading.BoundedSemaphore(int(os.environ.get("KB_MAX_DOCS_JOBS", "1")))
DOCS_TOOLS = {"search", "docs_get"}  # qmd loads a model: fewer of these at once
NAME_FIELDS = ("name", "uname", "username", "id", "uid")


def _audit(user: str, action: str, detail: str = "") -> None:
    """An audit event in the usage database (admin pages, Audit). Never breaks the request."""
    try:
        if USAGE is not None:
            USAGE.event(user, action, detail)
    except Exception:  # noqa: BLE001
        pass


def log(msg: str) -> None:
    sys.stderr.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    sys.stderr.flush()


# --------------------------------------------------------------------------- auth

class Identity:
    def __init__(self, user: dict, projects: list[str]):
        self.user = user
        self.projects = set(projects)

    @property
    def name(self) -> str:
        return next((str(self.user[k]) for k in NAME_FIELDS if self.user.get(k)), "?")


class AuthError(Exception):
    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status
        self.message = message


class Authenticator:
    """Checks a bearer token with the permission webhook and caches the verdict per token hash."""

    def __init__(self, url: str = "", ttl: float = CACHE_SECONDS,
                 timeout: float = AUTH_TIMEOUT, max_entries: int = 1000):
        self.url = url or PERMISSION_URL
        self.ttl = ttl
        self.timeout = timeout
        self.max_entries = max_entries
        self._cache: dict[str, tuple[float, Identity | AuthError]] = {}
        self._lock = threading.Lock()
        self.upstream_calls = 0  # for tests and logs

    @staticmethod
    def token_from_header(header: str | None) -> str:
        parts = (header or "").strip().split(None, 1)
        if len(parts) != 2 or parts[0].lower() != "bearer" or not parts[1].strip():
            raise AuthError(401, "missing bearer token")
        return parts[1].strip()

    def check(self, header: str | None) -> Identity:
        token = self.token_from_header(header)
        key = hashlib.sha256(token.encode()).hexdigest()
        now = time.monotonic()
        with self._lock:
            hit = self._cache.get(key)
            if hit and hit[0] > now:
                verdict = hit[1]
                if isinstance(verdict, AuthError):
                    raise verdict
                return verdict
        verdict = self._ask(token)
        if not (isinstance(verdict, AuthError) and verdict.status == 503):  # never cache an outage
            with self._lock:
                if len(self._cache) >= self.max_entries:
                    self._cache = {k: v for k, v in self._cache.items() if v[0] > now}
                    if len(self._cache) >= self.max_entries:
                        self._cache.clear()
                self._cache[key] = (now + self.ttl, verdict)
        if isinstance(verdict, AuthError):
            raise verdict
        return verdict

    def _ask(self, token: str) -> Identity | AuthError:
        """The permission webhook of access protocol v1: the token and the KB's projects in, the user
        and the allowed subset (or "*") out."""
        self.upstream_calls += 1
        known = sorted(kb_core.PROJECTS)
        try:
            extra = oauth.kb_login.hook_headers()
        except oauth.kb_login.LoginError:
            extra = {}
        req = urllib.request.Request(
            self.url, data=json.dumps({"protocol": 1, "projects": known}).encode(), method="POST",
            headers={"Authorization": f"Bearer {token}", "Accept": "application/json",
                     "Content-Type": "application/json", "User-Agent": "kb-http/1.0", **extra})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as r:
                status, body = r.status, r.read(1024 * 1024)
        except urllib.error.HTTPError as e:
            status, body = e.code, b""
        except Exception as e:  # noqa: BLE001  (URLError, timeout, TLS, reset)
            log(f"auth: permission webhook unreachable: {type(e).__name__}")
            return AuthError(503, "auth service unreachable")
        if status == 401:
            return AuthError(401, "invalid or expired token")
        if status != 200:
            return AuthError(403, f"access denied (permission webhook answered {status})")
        try:
            data = json.loads(body)
            user = data.get("user") or {}
            projects = data.get("projects")
            if projects == "*":
                projects = known
            if not isinstance(user, dict) or not isinstance(projects, list) \
                    or not all(isinstance(p, str) for p in projects):
                raise ValueError("unexpected shape")
        except (ValueError, AttributeError):
            log("auth: permission webhook answered 200 with an unexpected body")
            return AuthError(503, "auth service gave an unexpected answer")
        projects = [p for p in projects if p in known] if known else projects
        if not projects:
            return AuthError(403, "no KB projects for this user")
        return Identity(user, projects)


# --------------------------------------------------------------------------- usage

USAGE: Usage | None = None  # set by make_server()

USAGE_TOOL = {"name": "usage", "description": "How the KB is used: calls per tool and per day for "
              "everyone, and your own most frequent arguments. Never shows what other people asked, "
              "and no user names.",
              "inputSchema": {"type": "object", "properties": {}}}


# --------------------------------------------------------------------------- MCP

_warm_lock = threading.Lock()
_warm_at = float("-inf")


def warm_docs(every: float = 600.0) -> None:
    """Preload the qmd model at most once per `every` seconds: each warm-up is a qmd process of
    several hundred MB, so one per client session would add up."""
    global _warm_at
    with _warm_lock:
        if time.monotonic() - _warm_at < every:
            return
        _warm_at = time.monotonic()
    kb_core.warm_qmd()


def rpc_result(mid, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def rpc_error(mid, code: int, message: str) -> dict:
    return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": message}}


def handle_message(msg: dict, ident: Identity) -> dict | None:
    """One JSON-RPC message -> answer (None for a notification)."""
    if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0":
        return rpc_error(msg.get("id") if isinstance(msg, dict) else None, -32600,
                         "invalid request")
    method, mid = msg.get("method"), msg.get("id")
    is_notification = "id" not in msg
    params = msg.get("params") or {}
    if method == "initialize":
        asked = params.get("protocolVersion") if isinstance(params, dict) else None
        proto = asked if asked in SUPPORTED_PROTOCOLS else SUPPORTED_PROTOCOLS[0]
        warm_docs()
        return rpc_result(mid, {
            "protocolVersion": proto,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "kb", "version": kb_core.VERSION,
                           "apiContract": kb_core.API_CONTRACT},
            "instructions": kb_core.instructions(sorted(ident.projects))})
    if method == "ping":
        return rpc_result(mid, {})
    if method == "tools/list":
        return rpc_result(mid, {"tools": [*kb_core.tools(), USAGE_TOOL]})
    if method == "tools/call":
        if not isinstance(params, dict):
            return rpc_error(mid, -32602, "params must be an object")
        name, args = params.get("name", ""), params.get("arguments") or {}
        if name == USAGE_TOOL["name"]:
            text = USAGE.report(with_users=False, only_user=ident.name) if USAGE else "(usage counting is off)"
            return rpc_result(mid, {"content": [{"type": "text", "text": text}], "isError": False})
        if name not in kb_core.TOOLS_BY_NAME:
            return rpc_error(mid, -32602, f"unknown tool: {name}")
        if not isinstance(args, dict):
            return rpc_error(mid, -32602, "arguments must be an object")
        sem = DOCS_JOBS if name in DOCS_TOOLS else GRAPH_JOBS
        t0 = time.monotonic()
        try:
            with sem:
                text = kb_core.call_tool(name, args, ident.projects, ident.name)
            err = False
        except kb_core.ToolError as e:
            text, err = f"(error: {e})", True
        took = time.monotonic() - t0
        log(f"call user={ident.name} tool={name} projects={','.join(sorted(ident.projects))} "
            f"ok={not err} {took:.1f}s")
        if USAGE:
            USAGE.record(name, ident.name, args, not err, took)
        return rpc_result(mid, {"content": [{"type": "text", "text": text}], "isError": err})
    if is_notification:
        return None  # notifications/initialized and any other notification
    return rpc_error(mid, -32601, f"method not found: {method}")


class Handler(BaseHTTPRequestHandler):
    server_version = "kb-http/1.0"
    protocol_version = "HTTP/1.1"
    auth: Authenticator  # set on the subclass by make_server()
    admins: set = set()
    sessions = admin.Sessions()
    logins = admin.Logins()
    oauth: "oauth.Server | None" = None

    def log_message(self, fmt: str, *args) -> None:  # request line only, never headers
        log(f"{self.address_string()} {fmt % args}")

    def _send(self, status: int, body: dict | list | None, headers: dict | None = None) -> None:
        data = b"" if body is None else json.dumps(body).encode()
        self.send_response(status)
        if body is not None:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        if status >= 400:
            # An error can come before the body is read; the rest of the body must not be parsed
            # as the next request on a kept-alive connection.
            self.send_header("Connection", "close")
            self.close_connection = True
        self.end_headers()
        if data:
            self.wfile.write(data)

    def _not_allowed(self) -> None:
        if self.path.split("?")[0] != "/mcp":
            self._send(404, {"error": "not found"})
        else:
            self._send(405, {"error": "method not allowed"}, {"Allow": "POST"})

    do_DELETE = do_PUT = do_PATCH = _not_allowed

    # ------------------------------------------------------------------ OAuth (bin/oauth.py)
    def _base(self) -> str:
        """This server's public URL as the client sees it (nginx passes the prefix it strips)."""
        proto = self.headers.get("X-Forwarded-Proto") or "http"
        host = self.headers.get("X-Forwarded-Host") or self.headers.get("Host") or f"{HOST}:{PORT}"
        prefix = (self.headers.get("X-Forwarded-Prefix") or "").rstrip("/")
        return f"{proto}://{host}{prefix}"

    def _send_page(self, status: int, body: bytes, headers: dict | None = None) -> None:
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; "
                                                    "form-action 'self' http://localhost:* http://127.0.0.1:* http://[::1]:*; "
                                                    "frame-ancestors 'none'")
        # form-action also governs where a submitted form may be redirected: with 'self' alone the
        # browser blocked the final 302 to the MCP client's loopback callback after a good sign-in.
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _redirect(self, url: str) -> None:
        self.send_response(302)
        self.send_header("Location", url)
        self.send_header("Content-Length", "0")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def _body(self) -> bytes | None:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length < 0 or length > MAX_BODY:
            return None
        return self.rfile.read(length)

    def _form(self) -> dict | None:
        raw = self._body()
        if raw is None:
            return None
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip()
        if ctype == "application/json":
            try:
                data = json.loads(raw or b"{}")
            except ValueError:
                return None
            return data if isinstance(data, dict) else None
        return {k: v[0] for k, v in urllib.parse.parse_qs(raw.decode("utf-8", "replace")).items()}

    def _oauth_error(self, e: "oauth.OAuthError") -> None:
        self._send(e.status, {"error": e.error, "error_description": e.description})

    # ------------------------------------------------------------------ admin (bin/admin.py)
    def _cookie(self) -> str | None:
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == admin.COOKIE:
                return v
        return None

    def _set_cookie(self, sid: str, max_age: int) -> dict:
        secure = "; Secure" if (self.headers.get("X-Forwarded-Proto") or "") == "https" else ""
        prefix = (self.headers.get("X-Forwarded-Prefix") or "").rstrip("/")
        return {"Set-Cookie": f"{admin.COOKIE}={sid}; Path={prefix}/admin; HttpOnly; "
                              f"SameSite=Strict; Max-Age={max_age}{secure}"}

    def _admin(self, method: str, path: str) -> None:
        import addons
        if not self.admins or self.oauth is None or not addons.on("admin"):
            self._send(404, {"error": "not found"})
            return
        base = self._base()
        sid = self._cookie()
        session = self.sessions.get(sid)
        if path == "/admin/login":
            if method == "GET":
                self._send_page(200, admin.login_page(base))
                return
            self._admin_login(base)
            return
        if session is None:
            self._redirect(f"{base}/admin/login")
            return
        if method == "POST":
            form = self._form() or {}
            if not secrets_compare(str(form.get("csrf", "")), session["csrf"]):
                self._send_page(403, admin.page("KB admin", "<main><section>Form expired: reload the page.</section></main>"))
                return
            if path == "/admin/logout":
                _audit(admin_name(session["user"]), "admin sign-out")
                self.sessions.drop(sid)
                self.send_response(302)
                for k, v in {**self._set_cookie("", 0), "Location": f"{base}/admin/login"}.items():
                    self.send_header(k, v)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            if path == "/admin/rebuild":
                log(f"admin: rebuild by {admin_name(session['user'])}")
                _audit(admin_name(session["user"]), "rebuild")
                self._send_page(200, admin.status_page(base, session["csrf"], admin.status(self.oauth),
                                                       session["user"], admin.rebuild()))
                return
            if path == "/admin/clients/revoke":
                cid = str(form.get("client_id", ""))
                note = "Revoked." if self.oauth.revoke(cid) else "No such client."
                log(f"admin: revoke {cid[:12]} by {admin_name(session['user'])}")
                _audit(admin_name(session["user"]), "revoke client", f"{cid[:12]} {note}")
                self._send_page(200, admin.clients_page(base, session["csrf"], self.oauth.clients, note))
                return
            if path == "/admin/questions/label" and addons.on("questions"):
                tool, arg = str(form.get("tool", "")), str(form.get("arg", ""))
                project, how = str(form.get("project", "")), str(form.get("how", ""))
                who = admin_name(session["user"])
                if how == "clear":
                    USAGE.unlabel(tool, arg, project)
                    note = "Label cleared."
                elif USAGE.label(tool, arg, project, expected=str(form.get("expected", "")),
                                 no_answer=how == "no_answer", skip=how == "skip", by=who):
                    note = "Saved."
                else:
                    note = "Not saved: give the path or symbol, or choose \"No answer\" or \"Skip\"."
                _audit(who, "label question", f"{tool} {how} {arg[:60]}")
                self._send_page(200, admin.questions_page(base, session["csrf"], USAGE, note))
                return
            self._send(404, {"error": "not found"})
            return
        if path == "/admin":
            self._send_page(200, admin.status_page(base, session["csrf"], admin.status(self.oauth), session["user"]))
        elif path == "/admin/usage":
            q = {k: v[0] for k, v in urllib.parse.parse_qs(self.path.partition("?")[2]).items()}
            self._send_page(200, admin.usage_page(base, session["csrf"], USAGE, q))
        elif path == "/admin/audit" and addons.on("audit"):
            q = {k: v[0] for k, v in urllib.parse.parse_qs(self.path.partition("?")[2]).items()}
            self._send_page(200, admin.audit_page(base, session["csrf"], USAGE, q))
        elif path == "/admin/questions" and addons.on("questions"):
            self._send_page(200, admin.questions_page(base, session["csrf"], USAGE))
        elif path == "/admin/questions.json" and addons.on("questions"):
            self._send(200, {"questions": USAGE.golden() if USAGE else []})
        elif path == "/admin/clients":
            self._send_page(200, admin.clients_page(base, session["csrf"], self.oauth.clients))
        elif path == "/admin/index":
            self._send_page(200, admin.index_page(base, session["csrf"], USAGE))
        else:
            self._send(404, {"error": "not found"})

    def _admin_login(self, base: str) -> None:
        form = self._form() or {}
        env = self.oauth.env
        url, h = env["KB_LOGIN_URL"], oauth.kb_login.hook_headers(env)
        try:
            if form.get("lid"):
                challenge = self.logins.take(str(form["lid"]))
                if not challenge:
                    self._send_page(200, admin.login_page(base, error="The sign-in took too long: start again."))
                    return
                data = oauth.kb_login.post(url, {"challenge": challenge, "code": str(form.get("code", "")).strip()},
                                           headers=h)
            else:
                data = oauth.kb_login.post(url, {"username": str(form.get("username", "")),
                                                 "password": str(form.get("password", ""))}, headers=h)
                challenge = (data.get("two_factor") or {}).get("challenge")
                if challenge:
                    self._send_page(200, admin.login_page(base, "code", self.logins.put(challenge)))
                    return
            token = data.get("token")
            if not token:
                raise oauth.kb_login.LoginError("the login webhook answered without a token")
            ident = self.auth.check(f"Bearer {token}")
        except (oauth.kb_login.LoginError, AuthError) as e:
            log(f"admin: sign-in refused: {str(e)[:120]}")
            _audit(str(form.get("username", "")) or "?", "admin sign-in refused", str(e)[:200])
            self._send_page(200, admin.login_page(base, error=str(e)))
            return
        if not admin.is_admin(ident.user, self.admins):
            log(f"admin: {admin_name(ident.user)} is not an admin")
            _audit(admin_name(ident.user), "admin sign-in refused", "not an admin")
            self._send_page(403, admin.login_page(base, error="This account is not a KB admin."))
            return
        sid = self.sessions.create(ident.user, token)
        log(f"admin: signed in {admin_name(ident.user)}")
        _audit(admin_name(ident.user), "admin sign-in")
        self.send_response(302)
        for k, v in {**self._set_cookie(sid, admin.SESSION_TTL), "Location": f"{base}/admin"}.items():
            self.send_header(k, v)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _metrics(self) -> None:
        """GET /metrics (bin/metrics.py), only when KB_METRICS=on; 404 otherwise."""
        import addons
        if not (addons.on("metrics") or os.environ.get("KB_METRICS", "off").lower() == "on"):
            self._send(404, {"error": "not found"})
            return
        import metrics
        if not metrics.allowed(self.client_address[0], self.headers):
            self._send(401, {"error": "metrics need KB_METRICS_TOKEN"}, {"WWW-Authenticate": 'Basic realm="kb"'})
            return
        data = metrics.render(USAGE, self.oauth).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:  # noqa: N802
        path, _, qs = self.path.partition("?")
        if path == "/metrics":
            self._metrics()
            return
        if path == "/admin" or path.startswith("/admin/"):
            self._admin("GET", path.rstrip("/") or "/admin")
            return
        srv = self.oauth
        if srv is None:
            self._not_allowed()
            return
        base = self._base()
        if path in ("/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/mcp"):
            self._send(200, srv.resource_metadata(base))
        elif path.startswith("/.well-known/oauth-authorization-server") or \
                path.startswith("/.well-known/openid-configuration"):
            self._send(200, srv.server_metadata(base))
        elif path == "/authorize":
            q = {k: v[0] for k, v in urllib.parse.parse_qs(qs).items()}
            try:
                txn = srv.start(q)
            except oauth.OAuthError as e:
                self._send_page(400, oauth.page(f"{base}/authorize", "", "password", e.description))
                return
            self._send_page(200, oauth.page(f"{base}/authorize", txn, "password"))
        else:
            self._not_allowed()

    def _oauth_post(self, path: str) -> None:
        srv, base = self.oauth, self._base()
        form = self._form()
        if form is None:
            self._send(400, {"error": "invalid_request", "error_description": "unreadable body"})
            return
        if path == "/register":
            try:
                self._send(201, srv.register(form))
            except oauth.OAuthError as e:
                self._oauth_error(e)
        elif path == "/token":
            try:
                self._send(200, srv.token(form))
            except oauth.OAuthError as e:
                self._oauth_error(e)
        elif path == "/authorize":
            txn, step = str(form.get("txn", "")), form.get("step")
            action = f"{base}/authorize"
            try:
                if step == "code":
                    self._redirect(srv.code_step(txn, str(form.get("code", ""))))
                    return
                state, url = srv.password_step(txn, str(form.get("username", "")),
                                               str(form.get("password", "")))
                if state == "code":
                    self._send_page(200, oauth.page(action, txn, "code"))
                else:
                    self._redirect(url)
            except oauth.OAuthError as e:
                self._send_page(400, oauth.page(action, "", "password", e.description))
            except oauth.kb_login.LoginError as e:
                log(f"oauth: sign-in refused: {str(e)[:120]}")
                self._send_page(200, oauth.page(action, txn, step or "password", str(e)))
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self) -> None:  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/admin" or path.startswith("/admin/"):
            self._admin("POST", path.rstrip("/"))
            return
        if self.oauth is not None and path in ("/register", "/token", "/authorize"):
            self._oauth_post(path)
            return
        if path != "/mcp":
            self._send(404, {"error": "not found"})
            return
        try:
            ident = self.auth.check(self.headers.get("Authorization"))
        except AuthError as e:
            challenge = 'Bearer realm="kb"'
            if self.oauth is not None:
                challenge += f', resource_metadata="{self._base()}/.well-known/oauth-protected-resource"'
            extra = {"WWW-Authenticate": challenge} if e.status == 401 else {}
            body = {"error": e.message}
            if e.status == 401 and AUTH_HINT:
                body["hint"] = AUTH_HINT
            self._send(e.status, body, extra)
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > MAX_BODY:
            self._send(413, {"error": "body too large"})
            return
        try:
            payload = json.loads(self.rfile.read(length) or b"null")
        except (ValueError, UnicodeDecodeError):
            self._send(400, rpc_error(None, -32700, "parse error"))
            return
        if isinstance(payload, list):
            answers = [a for a in (handle_message(m, ident) for m in payload) if a is not None]
            self._send(200, answers) if answers else self._send(202, None)
        elif isinstance(payload, dict):
            answer = handle_message(payload, ident)
            self._send(200, answer) if answer is not None else self._send(202, None)
        else:
            self._send(400, rpc_error(None, -32600, "invalid request"))


def secrets_compare(a: str, b: str) -> bool:
    import hmac
    return hmac.compare_digest(a.encode(), b.encode())


def admin_name(user: dict) -> str:
    return next((str(user[k]) for k in admin.ID_FIELDS if user.get(k)), "?")


def make_server(host: str = HOST, port: int = PORT, auth: Authenticator | None = None,
                usage: Usage | None = None, oauth_env: dict | None = None,
                admins: set | None = None) -> ThreadingHTTPServer:
    global USAGE
    USAGE = usage
    admin.set_badge_source(lambda: USAGE.unlabelled() if USAGE is not None and hasattr(USAGE, "unlabelled") else 0)
    auth = auth or Authenticator()
    env = login_env() if oauth_env is None else oauth_env

    def check(token: str) -> None:
        auth.check(f"Bearer {token}")

    srv_oauth = oauth.Server(env, check, os.path.join(kb_core.KB, "logs", "oauth-clients.json")) \
        if env else None
    if srv_oauth is not None:
        srv_oauth.on_event = _audit
    handler = type("KbHandler", (Handler,), {"auth": auth, "oauth": srv_oauth,
                                              "admins": admin.admins() if admins is None else admins,
                                              "sessions": admin.Sessions(), "logins": admin.Logins()})
    srv = ThreadingHTTPServer((host, port), handler)
    srv.daemon_threads = True
    return srv


def refuse_reason(env: dict | None = None) -> str | None:
    """Why the server must not start, or None. Off unless explicitly switched on and configured."""
    env = os.environ if env is None else env
    if env.get("KB_SERVER", "off").lower() != "on":
        return ("kb-http is off. It is a shared, network-facing server: set KB_SERVER=on and "
                "KB_PERMISSION_URL=<permission webhook> to run it (docs/access-protocol.md).")
    if not env.get("KB_PERMISSION_URL"):
        return "kb-http: KB_PERMISSION_URL is not set — there is no way to check who is asking."
    return None


def main() -> int:
    if sys.argv[1:] == ["usage"]:
        print(Usage(USAGE_FILE).report(with_users=True))
        return 0
    reason = refuse_reason()
    if reason:
        print(reason, file=sys.stderr)
        return 2
    warm.enable()  # long-lived graphify and qmd: no cold start per call (bin/warm.py)
    kb_core.warm_qmd()
    usage = Usage(USAGE_FILE)
    srv = make_server(usage=usage)
    log(f"kb-http listening on {HOST}:{PORT}, permissions={PERMISSION_URL}, docs_mode={kb_core.DOCS_MODE}, "
        f"projects={','.join(kb_core.PROJECTS)}")
    warm_docs()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        usage.save()
    return 0


if __name__ == "__main__":
    sys.exit(main())
