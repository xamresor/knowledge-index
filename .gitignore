# Staging copies of the other projects' source (regenerated by bin/kb; not ours to commit)
/repos/

# qmd local index (regenerable via bin/kb kb)
/.qmd/

# Aggregated docs staging for qmd (rsynced from each project; regenerable)
/.docs/

# Generated route tables (regenerable via php artisan route:list)
/routes.*.json

# SCIP indexes of the add-on `scip` (bin/link_scip.py): code structure of the indexed projects
/scip/

# Generated graph artifacts — contain the indexed projects' code structure; not ours to commit.
# Regenerate locally with `make update`.
/graphify-out/

# Work folder of `kb update` while it post-processes the merged graph (removed at the end of a build)
/.build/

# Local project registry (real machine paths). Use kb.projects.toml.example as a template.
/kb.projects.toml

# Persisted local choices (e.g. the qmd embedding backend). Machine-specific.
/.kb.local

# Python bytecode
__pycache__/
*.pyc

# IDE
/.idea/
/.claude/settings.local.json


# Deployment data: the alias table names private projects/products/people (see aliases.toml.example)
aliases.toml

# Deployment data: the data dictionary per project names real tables (see datadict.toml.example)
/datadict/

# Vendored renderer: fetched by `make vendor`, not part of the source
web/vendor/

# The demo's copy of the shell, staged next to its data by `make demo` (the source is web/)
/examples/demo/web/

# Server logs and usage counters (bin/kb-refresh, bin/kb-http)
/logs/
sandbox/node_modules/

# Add-ons switched on locally (kb addon install)
/addons.json
/addons.json.tmp.*

# Benchmark questions about private code (bench/graph_vs_grep.py reads them)
/bench/local/

# External add-ons installed here (links to their own folders, often private)
/plugins/

# Documentation site (npm run docs:build)
/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# The users plugin (contrib/users): token hashes of real people. Never in git.
/users.json
/users.json.lock
/.users.json.*.tmp
# Admin names of one server (KB_ADMINS file).
/admins.txt
# Mail settings of the users plugin: holds the SMTP password. Never in git.
/smtp.env

# Settings an admin changes on the running server (bin/settings.py): local to one server.
/settings.json
/settings.json.tmp.*
